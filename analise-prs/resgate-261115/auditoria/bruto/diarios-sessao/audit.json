ivo' : 'Inativo'} tone={s.status === 'active' ? 'success' : 'muted'} dot />", "      <div className=\"mt-3 flex flex-wrap gap-1\">", "        {rules.slice(0, 3).map((r, i) => {", "        {rules.length > 3 && <span className=\"text-3xs text-muted-foreground\">+{rules.length - 3}</span>}", "        {rules.length === 0 && <span className=\"text-2xs text-muted-foreground italic\">Toda a base</span>}", "      <p className=\"mt-3\"><span className=\"text-sm font-bold text-foreground\">{fmtInt(s.estimated_count)}</span><span className=\"text-2xs text-foreground-secondary ml-1\">contatos</span></p>", " * X116 \u2014 painel \"Detalhes do segmento\": cabe\u00e7alho fixo com \u21bb (reconta o p\u00fablico) e \u2715 (Esc tamb\u00e9m", " * fecha e devolve o foco \u00e0 linha), \"Principais crit\u00e9rios\" por extenso com \"Editar\", origem por", " * extenso e \"Usar em campanha\" desabilitado com o motivo quando o segmento est\u00e1 inativo.", "  const { data: est, refetch: recount, isFetching: recounting } = useAudienceEstimate(s.rules, true);", "  const rules = rulesOf(s);", "  const inactive = s.status !== 'active';", "  // Esc fecha o painel \u2014 a menos que outro handler (di\u00e1logo/menu do Radix) j\u00e1 o tenha consumido.", "  // `onClose` pode mudar de identidade a cada render do pai: o listener l\u00ea a vers\u00e3o atual por ref e", "  // fica inscrito uma \u00fanica vez.", "  const onCloseRef = useRef(onClose);", "  useEffect(() => { onCloseRef.current = onClose; }, [onClose]);", "    const onKeyDown = (e: KeyboardEvent) => {", "      if (teclaDe(e) !== 'Escape' || e.defaultPrevented) return;", "      onCloseRef.current();", "    document.addEventListener('keydown', onKeyDown);", "    return () => document.removeEventListener('keydown', onKeyDown);", "    <RailCard icon={Bookmark} color=\"violet\" title=\"Detalhes do segmento\" subtitle={s.description || undefined}", "      right={(", "        <div className=\"flex items-center gap-1.5\">", "            type=\"button\" onClick={() => { void recount(); }} disabled={recounting}", "            aria-label=\"Recontar p\u00fablico deste segmento\" title=\"Recontar p\u00fablico\"", "            className=\"h-7 w-7 rounded-md border border-border/70 bg-input/40 flex items-center justify-center hover:bg-muted/50 disabled:opacity-60\"", "            <RefreshCw className={cn('w-4 h-4', recounting && 'motion-safe:animate-spin')} aria-hidden />", "      <p className=\"text-sm font-semibold text-foreground truncate\">{s.name}</p>", "        <div className=\"flex items-center justify-between gap-2 mb-1.5\">", "          <p className=\"text-2xs font-semibold text-foreground-secondary\">Principais crit\u00e9rios</p>", "          <button type=\"button\" onClick={onEdit} className=\"text-2xs font-semibold text-[hsl(var(--primary-text))] underline underline-offset-2 hover:opacity-80\">Editar</button>", "        <div className=\"flex flex-wrap gap-1.5\">", "          {rules.length === 0", "            ? <span className=\"text-2xs text-muted-foreground italic\">Toda a base</span>", "            : rules.map((r) => <span key={r.id} className=\"text-2xs px-2 py-0.5 rounded-md bg-primary/10 text-[hsl(var(--primary-text))] border border-primary/20\">{ruleText(r)}</span>)}", "      <MetaRow label=\"Origem\" value={ORIGIN_LONG[s.origin] ?? ORIGIN_LONG.custom} />", "        <PrimaryButton icon={Zap} onClick={onCampaign} disabled={inactive} className=\"w-full justify-center\">Usar em campanha</PrimaryButton>", "        {inactive && <p className=\"text-2xs text-foreground-secondary\">Segmento inativo: n\u00e3o pode ser usado em campanha.</p>}"]}, {"f": "src/components/admin/MediaMigrationTool.tsx", "added": 211, "missing": 49, "lines": ["/** Prefixos de CDN tempor\u00e1ria do WhatsApp \u2014 o mesmo filtro que a Edge `migrate-media-storage` usa. */", "const CDN_TEMP_PREFIXES = ['https://mmg.whatsapp.net/', 'https://pps.whatsapp.net/'] as const;", "/** A\u00e7\u00e3o que a Edge grava em `audit_logs` ao fim de cada execu\u00e7\u00e3o. */", "const MIGRATION_ACTION = 'media_migration';", "/** Quantas execu\u00e7\u00f5es o hist\u00f3rico mostra. */", "const HISTORY_LIMIT = 10;", "interface MigrationHistoryEntry {", "  id: string;", "  createdAt: string;", "  authorName: string | null;", "function asCount(value: unknown): number {", "  return typeof value === 'number' && Number.isFinite(value) ? value : 0;", "/** Conta, sem trazer linhas (`head`), as mensagens que ainda apontam para a CDN tempor\u00e1ria. */", "async function countPendingMedia(): Promise<number> {", "  let total = 0;", "  for (const prefix of CDN_TEMP_PREFIXES) {", "    const { count, error } = await supabase", "      .from('messages')", "      .select('id', { count: 'exact', head: true })", "      .like('media_url', `${prefix}%`);", "    if (error) throw error;", "    total += asCount(count);", "  return total;", "/** Hist\u00f3rico real: uma linha de `audit_logs` por execu\u00e7\u00e3o da Edge (s\u00f3 contagens, sem URL). */", "async function fetchMigrationHistory(): Promise<MigrationHistoryEntry[]> {", "  const { data, error } = await supabase", "    .from('audit_logs')", "    .select('id, user_id, created_at, details')", "    .eq('action', MIGRATION_ACTION)", "    .order('created_at', { ascending: false })", "    .limit(HISTORY_LIMIT);", "  if (error) throw error;", "  const logs = data ?? [];", "  const userIds = [...new Set(logs.map((log) => log.user_id).filter((id): id is string => Boolean(id)))];", "  const { data: profiles } = userIds.length > 0", "    ? await supabase.from('profiles').select('user_id, name').in('user_id', userIds)", "    : { data: [] as { user_id: string; name: string | null }[] };", "  return logs.map((log) => {", "    const details =", "      typeof log.details === 'object' && log.details !== null", "        ? (log.details as Record<string, unknown>)", "        : {};", "    return {", "      id: log.id,", "      createdAt: log.created_at,", "      authorName: profiles?.find((profile) => profile.user_id === log.user_id)?.name ?? null,", "      processed: asCount(details.processed),", "      migrated: asCount(details.migrated),", "      failed: asCount(details.failed),"]}, {"f": "src/hooks/integrations/useTalkXSegments.ts", "added": 16, "missing": 15, "lines": ["        // \"Em breve\" (lead_score/risk_score/lead_origin): a regra \u00e9 completa e bem descrita", "const BRIDGE_FIELDS: readonly RuleField[] = ['real_sector', 'real_uf'];", "const isBridgeField = (field: RuleField): boolean => BRIDGE_FIELDS.includes(field);", " * Enquanto o front n\u00e3o pr\u00e9-resolve a ponte Singu, uma regra real_* FALHA FECHADA:", " * mandar o payload sem ela devolveria mais contatos do que a audi\u00eancia pedida", " * (e um grupo s\u00f3 com real_* viraria `groups: []`, que o motor l\u00ea como base inteira).", "function assertNoBridgeFields(rules: SegmentRules | null | undefined): void {", "  for (const group of rules?.groups ?? []) {", "    const bridge = group.rules.find((rule) => isBridgeField(rule.field));", "    if (bridge) throw new Error(`${bridge.field} requer pr\u00e9-resolu\u00e7\u00e3o via p_contact_ids antes de chamar a RPC`);", "  // Campos da ponte Singu (real_sector/real_uf) chegam ao motor como contact_ids", "  // pr\u00e9-resolvidos (p_contact_ids): nunca viram filtro PostgREST direto.", "  if (isBridgeField(r.field)) return null;", "  assertNoBridgeFields(rules);", "  assertNoBridgeFields(rules);"]}, {"f": "ESTADO.md", "added": 10, "missing": 7, "lines": ["| `ai-kb-ingest` | A | `src/hooks/integrations/useKnowledgeBase.ts:132` \u00b7 `src/hooks/integrations/useKnowledgeBase.ts:203` |", "| `connection-health-check` | A | `src/components/connections/ConnectionsView.tsx:130` \u00b7 `src/components/diagnostics/ConnectionHealthPanel.tsx:95` \u00b7 `src/components/monitoring/hooks/useMonitoringActions.ts:18` \u00b7 `supabase/migrations/20260924100800_schedule_connection_health_check_cron.sql:16` \u00b7 `supabase/migrations/20260930250000_