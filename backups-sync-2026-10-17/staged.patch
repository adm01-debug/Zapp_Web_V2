+
+  it('(7) leitura de campanhas com erro mostra o erro do kit, nunca o vazio, e "Tentar novamente" refaz a leitura', async () => {
+    window.history.replaceState(null, '', '/?view=talkx&tab=monitor');
+    h.campaigns = [];
