+  assert.deepEqual(await encontrarIssue(gh, "o", "r", "bot-alert", "Alerta"), issue);
+});
+
+// --- abrirOuRotacionar ---
+
+test("abrirOuRotacionar: cria issue quando não existe", async () => {
+  const calls = [];
