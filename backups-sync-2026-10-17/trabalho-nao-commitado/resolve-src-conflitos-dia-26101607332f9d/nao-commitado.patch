+  assert.ok(!topo.split('\n').some((l) => /:\s*write\b/.test(l)), 'scorecard.yml: write no nível do workflow');
+  // id-token: write no job que usa ossf/scorecard-action e em nenhum outro (Codex, PR #1952).
+  const comToken = [];
