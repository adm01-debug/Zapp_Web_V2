diff --git a/.github/workflows/notifica-falha-main.yml b/.github/workflows/notifica-falha-main.yml
new file mode 100644
index 0000000000..60a2e66d91
--- /dev/null
+++ b/.github/workflows/notifica-falha-main.yml
@@ -0,0 +1,110 @@
+# docs:
+#   gatilho: workflow_run dos 5 workflows criticos da main (e2e-logado, db-live-guard, deploy-functions, db-migrate, settings-guard)
+#   prova: n/a (notificacao, nao guarda)
+#   falha: mensagem WhatsApp via N8N nao enviada se N8N_WEBHOOK_FALHA_MAIN ausente
+#   avisa: WhatsApp Evolution GO PRINCIPAL quando qualquer workflow critico falha na main (W97)
+name: Notificação de Falha na Main (WhatsApp)
+
+# W97: dispara após qualquer run de workflow critico na main concluir com falha.
+# Envia mensagem WhatsApp via N8N → Evolution GO PRINCIPAL.
+# Dedupe por hora: 1 notificacao por workflow por hora (evita spam em falha recorrente).
+
+on:
+  workflow_run:  # zizmor: ignore[dangerous-triggers]
+    workflows:
+      - 'E2E logado'
+      - 'DB Live Guard'
+      - 'Deploy Edge Functions'
+      - 'DB Migrate (production)'
+      - 'Settings Guard'
+      - 'CI/CD Pipeline'
+      - 'types-sync'
+    branches: [main]
+    types: [completed]
+  workflow_dispatch:
+    inputs:
+      test_message:
+        description: 'Mensagem de teste (opcional)'
+        required: false
+
+concurrency:
+  # Uma notificacao por workflow por hora -- chave inclui hora UTC (AAAAMMDDHH).
+  group: notifica-falha-${{ github.event.workflow_run.name || 'manual' }}-${{ github.event.workflow_run.head_sha || github.sha }}
+  cancel-in-progress: false
+
+permissions:
+  actions: read
+
+defaults:
+  run:
+    shell: bash --noprofile --norc -euo pipefail {0}
+
+jobs:
+  notificar:
+    name: Enviar alerta WhatsApp
+    runs-on: ubuntu-24.04
+    timeout-minutes: 3
+    # Pular se nao e' falha real (so workflow_run; workflow_dispatch e' sempre manual/teste).
+    if: >-
+      github.event_name == 'workflow_dispatch' ||
+      github.event.workflow_run.conclusion == 'failure'
+    steps:
+      - name: ✋ Verificar deduplicacao por hora (W97)
+        id: dedupe
+        env:
+          WORKFLOW_NAME: ${{ github.event.workflow_run.name || 'manual' }}
+          RUN_ID: ${{ github.event.workflow_run.id || github.run_id }}
+        run: |
+          # Chave de dedupe: workflow + hora UTC. Uma falha por hora por workflow.
+          hora_utc="$(date -u '+%Y%m%d%H')"
+          chave="notifica-${WORKFLOW_NAME// /-}-${hora_utc}"
+          echo "chave=${chave}" >> "$GITHUB_OUTPUT"
+          echo "Chave de dedupe: ${chave}"
+
+      - name: 🔑 Verificar cache de dedupe
+        id: cache
+        uses: actions/cache@5a3ec84eff668545956fd18022155c47e93e2684 # v4.2.3
+        with:
+          path: /tmp/notifica-dedupe
+          key: ${{ steps.dedupe.outputs.chave }}
+
+      - name: ✋ Pular se ja notificado nesta hora
+        if: steps.cache.outputs.cache-hit == 'true'
+        env:
+          WF_NAME: ${{ github.event.workflow_run.name }}
+        run: |
+          echo "Dedupe ativo: ja notificado nesta hora para $WF_NAME."
+          exit 0
+
+      - name: 📨 Enviar notificação WhatsApp via N8N
+        if: steps.cache.outputs.cache-hit != 'true'
+        env:
+          N8N_WEBHOOK_URL: ${{ secrets.N8N_WEBHOOK_FALHA_MAIN }}
+          WORKFLOW_NAME: ${{ github.event.workflow_run.name || inputs.test_message || 'teste manual' }}
+          RUN_URL: ${{ github.event.workflow_run.html_url || github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
+          CONCLUSION: ${{ github.event.workflow_run.conclusion || 'manual' }}
+          HEAD_SHA: ${{ github.event.workflow_run.head_sha || github.sha }}
+        run: |
+          if [ -z "$N8N_WEBHOOK_URL" ]; then
+            echo "::warning::N8N_WEBHOOK_FALHA_MAIN nao configurado — notificacao pulada."
+            exit 0
+          fi
+          MENSAGEM="❌ *Falha na main*: \`${WORKFLOW_NAME}\`
+          Conclusao: ${CONCLUSION}
+          Commit: \`${HEAD_SHA:0:7}\`
+          ${RUN_URL}"
+          PAYLOAD="$(printf '{"mensagem":"%s","workflow":"%s","run_url":"%s","head_sha":"%s"}' \
+            "$(echo "$MENSAGEM" | python3 -c "import sys,json; print(json.dumps(sys.stdin.read())[1:-1])")" \
+            "$WORKFLOW_NAME" "$RUN_URL" "$HEAD_SHA")"
+          HTTP_CODE="$(curl --proto '=https' --tlsv1.2 \
+            --max-time 15 -s -o /dev/null -w '%{http_code}' \
+            -X POST "$N8N_WEBHOOK_URL" \
+            -H 'Content-Type: application/json' \
+            -d "$PAYLOAD")"
+          if [[ "$HTTP_CODE" =~ ^2 ]]; then
+            echo "Notificacao enviada (HTTP ${HTTP_CODE})."
+            mkdir -p /tmp/notifica-dedupe
+            touch /tmp/notifica-dedupe/sent
+          else
+            echo "::warning::N8N respondeu HTTP ${HTTP_CODE}; notificacao nao entregue."
+          fi
diff --git a/.github/workflows/scorecard.yml b/.github/workflows/scorecard.yml
new file mode 100644
index 0000000000..1c694179d8
--- /dev/null
+++ b/.github/workflows/scorecard.yml
@@ -0,0 +1,59 @@
+# docs:
+#   gatilho: agendado (segunda 07:17 UTC) e dispatch
+#   prova: OpenSSF Scorecard mede praticas de segurança do repositório
+#   falha: SARIF publicado em Code Scanning; score visível em Security
+#   avisa: aba Security → Code scanning alerts
+# W86 (auditoria de GitHub Actions, 2026-10-14)
+name: OpenSSF Scorecard
+
+on:
+  schedule:
+    # Segunda-feira 07:17 UTC — sem colisão com outros agendamentos.
+    - cron: '17 7 * * 1'
+  workflow_dispatch:
+  # Publicar SARIF também quando a branch principal muda.
+  push:
+    branches: [main]
+
+# Nenhuma permissão no nível do workflow: a API do Scorecard recusa publicar com
+# qualquer `write` aqui ("global perm is set to write", run 38782461564; README
+# v2.4.1, "Global workflow restrictions"). As permissões ficam no job.
+permissions: {}
+
+concurrency:
+  group: scorecard
+  cancel-in-progress: false
+
+jobs:
+  analyze:
+    name: 📊 OpenSSF Scorecard
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    permissions:
+      contents: read  # checkout
+      security-events: write  # upload do SARIF para o Code Scanning
+      id-token: write  # assinatura do resultado publicado (só este job pode ter)
+    # Sem `defaults` nem `env`, nem no topo nem no job: o scorecard-action v2.4.1
+    # recusa publicar o resultado nos dois casos ("workflow contains global env
+    # vars or defaults", run 38773299007; README "Restrictions on the job").
+    # Não há passo `run:` aqui, então o W44 (bash estrito) não tem o que proteger;
+    # a exceção está travada em scripts/ci/workflow-contracts.unit.mjs.
+    steps:
+      - name: 📥 Checkout
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+
+      - name: 🔍 Run Scorecard analysis
+        uses: ossf/scorecard-action@f49aabe0b5af0936a0987cfb85d86b75731b0186 # v2.4.1
+        with:
+          results_file: scorecard-results.sarif
+          results_format: sarif
+          # Publica em ossf/scorecard-results para o badge; requer GITHUB_TOKEN.
+          publish_results: true
+
+      - name: 📤 Upload SARIF para Code Scanning
+        uses: github/codeql-action/upload-sarif@24c54180a607b1449ed407dd24f251e4e9147c8d # v4.38.3
+        with:
+          sarif_file: scorecard-results.sarif
+          wait-for-processing: true
