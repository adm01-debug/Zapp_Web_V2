+test('W44: todos os workflows declaram defaults.run.shell com bash strict', () => {
+  const SHELL = /defaults:\s*\n\s+run:\s*\n\s+shell:\s*bash\s+--noprofile\s+--norc\s+-euo\s+pipefail\s+\{0\}/s;
