+    const alertasHeading = screen.getByText('Alertas Ativos (2)').closest('h2');
+    expect(alertasHeading).toBeTruthy();
+
+    // Ordem real de TODOS os cabecalhos renderizados: nenhum nivel sobe mais de 1.
