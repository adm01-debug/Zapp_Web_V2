+DECLARE v text[];
+BEGIN
+  SELECT COALESCE(tags,'{}'::text[]) INTO v FROM public.contacts WHERE id='d0000000-0000-0000-0000-000000000002';
+  PERFORM pg_sleep(4);
+  UPDATE public.contacts SET tags = v || ARRAY['tag_lida'] WHERE id='d0000000-0000-0000-0000-000000000002';
+END $$;
