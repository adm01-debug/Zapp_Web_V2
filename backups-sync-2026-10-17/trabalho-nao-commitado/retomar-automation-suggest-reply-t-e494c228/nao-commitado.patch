+    const last = focusables[focusables.length - 1];
+    const active = document.activeElement;
+    if (event.shiftKey) {
+      if (active === first || active === node) {
+        event.preventDefault();
+        last.focus();
+      }
+    } else if (active === last || active === node) {
+      event.preventDefault();
+      first.focus();
+    }
+  };
