+    try {
+      press('m', {}, input);
+      expect(result.current.viewMode).toBe('grid');
+    } finally {
+      input.remove();
+    }
+  });
+
+  it('não troca de visualização com um diálogo aberto nem com modificador', () => {
+    const { result } = renderHook(() => useContactsViewState());
+    const dialog = document.createElement('div');
