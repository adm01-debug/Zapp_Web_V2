+
+// R2 — a data vem do banco (created_at/updated_at). Quando chega vazia, nula
+// ou como texto livre, o date-fns lança `RangeError: Invalid time value` e a
+// linha da lista desaparece inteira. O contrato aqui é: devolver o marcador
+// `—` (a mesma linguagem de "sem dado" usada no resto da UI), nunca quebrar.
+describe('datas inválidas devolvem o marcador, sem quebrar a tela', () => {
+  const MARCADOR = '—';
+  const INVALIDAS: Array<[string, unknown]> = [
+    ['string vazia', ''],
+    ['só espaços', '   '],
+    ['texto livre', 'não é uma data'],
+    ['null', null],
+    ['undefined', undefined],
+    ['Date inválido', new Date('nada')],
+  ];
+
+  it.each(INVALIDAS)('formatRelativeTime: %s → marcador', (_caso, entrada) => {
+    expect(formatRelativeTime(entrada as string)).toBe(MARCADOR);
+  });
+
+  it.each(INVALIDAS)('formatSmartDate: %s → marcador', (_caso, entrada) => {
+    expect(formatSmartDate(entrada as string)).toBe(MARCADOR);
+  });
+
+  it.each(INVALIDAS)('formatShortDate: %s → marcador', (_caso, entrada) => {
+    expect(formatShortDate(entrada as string)).toBe(MARCADOR);
+  });
+
+  it.each(INVALIDAS)('formatFullDateTime: %s → marcador', (_caso, entrada) => {
+    expect(formatFullDateTime(entrada as string)).toBe(MARCADOR);
+  });
+
+  it('data válida continua formatada normalmente (guarda não engole o caminho feliz)', () => {
+    expect(formatRelativeTime(new Date(2026, 9, 7, 14, 30, 0))).toBe('há 30 minutos');
+    expect(formatShortDate('2026-10-07T12:00:00')).toBe('07/10/2026');
+  });
+});
