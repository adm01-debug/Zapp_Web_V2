# ==============================================================================
# ZAPP-WEB - CONFIGURAÇÃO DE AMBIENTE
# ==============================================================================
# Copie este arquivo para .env.local e preencha com os valores reais
# NUNCA commitar o arquivo .env com valores reais!

# ==============================================================================
# SUPABASE (OBRIGATÓRIO)
# ==============================================================================
VITE_SUPABASE_URL=https://tnnnlkbymytvtqngbbqh.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# GESTÃO DE CLIENTES — CRM Promobrindes (banco externo, projeto pgxfvjmuubtbowutlide)
VITE_CLIENTES_SUPABASE_URL=https://pgxfvjmuubtbowutlide.supabase.co
VITE_CLIENTES_SUPABASE_ANON_KEY=your-external-anon-key

# ==============================================================================
# EVOLUTION GO - WHATSAPP (OBRIGATÓRIO para Edge Functions)
# Instalação oficial: evoapicloud/evolution-go na VPS Hostinger.
# ==============================================================================
EVOLUTION_API_URL=https://evolution-go-rxj2.srv1481814.hstgr.cloud
# GLOBAL_API_KEY da Evolution GO (endpoints admin: /instance/all, /instance/create…)
EVOLUTION_API_KEY=sua-evolution-global-api-key
# Token da instância (endpoints por instância: /send/*, /message/*, /instance/connect…)
EVOLUTION_INSTANCE_TOKEN=seu-token-da-instancia
# Nome da instância padrão na Evolution GO
EVOLUTION_INSTANCE_NAME=PRINCIPAL
# Flavor da API: 'go' (padrão, Evolution GO) ou 'v2' (Evolution API v2 legada,
# desativa a tradução de rotas em _shared/evolution-go-routes.ts)
EVOLUTION_API_FLAVOR=go

# ==============================================================================
# SENTRY - OBSERVABILIDADE (RECOMENDADO)
# ==============================================================================
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
VITE_SENTRY_ENVIRONMENT=development

# ==============================================================================
# GMAIL INTEGRATION - OAUTH2 (OPCIONAL)
# ==============================================================================
GMAIL_CLIENT_ID=xxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxx
GMAIL_REDIRECT_URI=https://tnnnlkbymytvtqngbbqh.supabase.co/functions/v1/gmail-oauth

# ==============================================================================
# AI PROVIDERS - CHATBOTS (OPCIONAL)
# ==============================================================================
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GROQ_API_KEY=gsk_xxx

# ==============================================================================
# APP CONFIG
# ==============================================================================
VITE_APP_NAME=ZAPP-WEB
VITE_APP_ENV=development

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
VITE_ENABLE_GAMIFICATION=true
VITE_ENABLE_GMAIL_INTEGRATION=false

# ==============================================================================
# BITRIX24 (OPCIONAL - se integrado)
# ==============================================================================
# VITE_BITRIX_WEBHOOK_URL=https://promobrindes.bitrix24.com.br/rest/1/xxx/

# ==============================================================================
# STORAGE R2 (OPCIONAL)
# ==============================================================================
# R2_ACCOUNT_ID=xxx
# R2_ACCESS_KEY_ID=xxx
# R2_SECRET_ACCESS_KEY=xxx
# R2_BUCKET_NAME=zapp-media
