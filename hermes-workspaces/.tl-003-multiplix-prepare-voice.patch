--- /dev/null
+++ b/supabase/functions/multiplix-prepare-voice/index.test.ts
@@ -0,0 +1,409 @@
+// F65 (Bloco H — Voz): contrato da edge `multiplix-prepare-voice`.
+//
+// Duas camadas, como no contrato do F64:
+//  1. as DECISOES puras — o hash de deduplicacao (`sha256(roteiro final, voice_id, modelo,
+//     voice_settings)`), o caminho no bucket privado, o agrupamento por roteiro e quem nao tem grant;
+//  2. o HANDLER, com `fetch` stubado: 401 sem bearer, 503 sem env, 400 fora do contrato, o aceite do
+//     F65 ("50 contatos com roteiro comum = 1 chamada") e a recusa nomeada do lote acima do teto e da
+//     voz sem grant — nos dois casos SEM gastar cota do provedor.
+//
+// `requireAuth` bate em `${SUPABASE_URL}/auth/v1/user`; o resto e PostgREST, Storage e o proprio
+// `elevenlabs-tts`. O stub roteia por trecho de URL (e, quando preciso, pelo metodo), entao cada
+// teste declara exatamente as respostas do seu caminho e o contador de chamadas de TTS e medido.
+import {
+  assetPath,
+  canonicalVoiceSettings,
+  dedupeScripts,
+  handleMultiplixPrepareVoiceRequest,
+  MAX_DISTINCT_TTS_PER_REQUEST,
+  MULTIPLIX_PREPARE_VOICE_TOO_MANY_DISTINCT,
+  MULTIPLIX_VOICE_SEM_AUTORIZACAO,
+  scriptHash,
+  voicesWithoutGrant,
+  type VoiceRequestItem,
+} from './index.ts';
+import type { CallerContext, VoiceGrantRow } from '../multiplix-voices/index.ts';
+
+function assert(condition: unknown, message: string): asserts condition {
+  if (!condition) throw new Error(message);
+}
+
+// ── autores ────────────────────────────────────────────────────────────────────
+const USER_B = '20000000-0000-0000-0000-00000000000b';
+const PERFIL_B = '10000000-0000-0000-0000-00000000000b';
+const VOZ_OK = 'voice-autorizada';
+const VOZ_REVOGADA = 'voice-revogada';
+const ASSET_ID = '30000000-0000-0000-0000-000000000001';
+const HASH_REAPROVEITADO = 'b'.repeat(64);
+
+function item(over: Partial<VoiceRequestItem> = {}): VoiceRequestItem {
+  return { texto: 'Ola, tudo bem?', voice_id: VOZ_OK, modelo: 'eleven_v3', ...over };
+}
+
+function grantRow(over: Partial<VoiceGrantRow> = {}): VoiceGrantRow {
+  return {
+    voice_id: VOZ_OK, titular: 'Titular A', roles: ['agent'], perfis: null,
+    origem: 'contrato-2026-01', revoked_at: null, ...over,
+  };
+}
+
+// ────────────────────────────── 1. decisoes ────────────────────────────────────
+Deno.test('F65: scriptHash e estavel e muda com roteiro, voz, modelo e settings', async () => {
+  const base = item();
+  const h = await scriptHash(base);
+  assert(/^[0-9a-f]{64}$/.test(h), `hash deveria ser sha256 hex: ${h}`);
+  assert(await scriptHash(item()) === h, 'o mesmo item deveria dar o mesmo hash');
+  assert(await scriptHash(item({ texto: 'Outro roteiro' })) !== h, 'roteiro diferente deveria mudar o hash');
+  assert(await scriptHash(item({ voice_id: 'outra-voz' })) !== h, 'voice_id diferente deveria mudar o hash');
+  assert(await scriptHash(item({ modelo: 'eleven_multilingual_v2' })) !== h, 'modelo diferente deveria mudar o hash');
+  assert(
+    await scriptHash(item({ voice_settings: { stability: 0.4 } })) !== h,
+    'voice_settings diferente deveria mudar o hash',
+  );
+});
+
+Deno.test('F65: a ORDEM das chaves de voice_settings nao muda o hash (canoniza antes de digerir)', async () => {
+  const a = item({ voice_settings: { stability: 0.5, similarity_boost: 0.75 } });
+  const b = item({ voice_settings: { similarity_boost: 0.75, stability: 0.5 } });
+  assert(
+    await scriptHash(a) === await scriptHash(b),
+    'a mesma configuracao em ordem diferente gerou hash diferente — geraria audio duplicado',
+  );
+  assert(
+    canonicalVoiceSettings({ b: 1, a: 2 }) === canonicalVoiceSettings({ a: 2, b: 1 }),
+    'canonicalVoiceSettings nao ordena as chaves',
+  );
+  assert(canonicalVoiceSettings(null) === '[]', 'sem settings o canonico deveria ser a lista vazia');
+});
+
+Deno.test('F65: assetPath grava dentro do bucket privado em <departamento>/<hash>.mp3', () => {
+  const caminho = assetPath('comercial', 'a'.repeat(64));
+  assert(caminho === `comercial/${'a'.repeat(64)}.mp3`, `caminho inesperado: ${caminho}`);
+  assert(!caminho.startsWith('/'), 'caminho nao deveria comecar com barra (o bucket e o prefixo)');
+});
+
+Deno.test('F65: 50 contatos com roteiro comum = 1 roteiro distinto com 50 indices', async () => {
+  const itens = Array.from({ length: 50 }, () => item());
+  const distintos = await dedupeScripts(itens);
+  assert(distintos.length === 1, `deveria sobrar 1 roteiro distinto: ${distintos.length}`);
+  assert(distintos[0].indexes.length === 50, `os 50 contatos deveriam cair no mesmo roteiro: ${distintos[0].indexes.length}`);
+  assert(distintos[0].indexes[0] === 0 && distintos[0].indexes[49] === 49, 'os indices deveriam preservar a ordem');
+});
+
+Deno.test('F65: roteiros diferentes viram roteiros distintos, na ordem de primeira aparicao', async () => {
+  const distintos = await dedupeScripts([
+    item({ texto: 'A' }),
+    item({ texto: 'B' }),
+    item({ texto: 'A' }),
+    item({ texto: 'C' }),
+    item({ texto: 'B' }),
+  ]);
+  assert(distintos.length === 3, `deveriam ser 3 roteiros: ${distintos.length}`);
+  assert(
+    JSON.stringify(distintos.map((d) => d.item.texto)) === JSON.stringify(['A', 'B', 'C']),
+    `ordem inesperada: ${distintos.map((d) => d.item.texto).join(',')}`,
+  );
+  assert(JSON.stringify(distintos[0].indexes) === JSON.stringify([0, 2]), 'indices do roteiro A errados');
+  assert(JSON.stringify(distintos[1].indexes) === JSON.stringify([1, 4]), 'indices do roteiro B errados');
+});
+
+Deno.test('F65: voicesWithoutGrant acha so a voz sem grant vivo que alcance o chamador', () => {
+  const caller: CallerContext = { userId: USER_B, roleNames: ['agent'], profileId: PERFIL_B, isStaff: false };
+  const grants = [
+    grantRow({ voice_id: 'voice-por-papel', roles: ['agent'] }),
+    grantRow({ voice_id: VOZ_REVOGADA, roles: ['agent'], revoked_at: '2026-10-03T00:00:00Z' }),
+  ];
+  const sem = voicesWithoutGrant(['voice-por-papel', VOZ_REVOGADA, 'voice-inexistente'], grants, caller);
+  assert(JSON.stringify(sem) === JSON.stringify(['voice-inexistente', VOZ_REVOGADA].sort()), `sem grant inesperado: ${sem.join(',')}`);
+  // staff (admin/supervisor) alcanca qualquer grant vivo — a revogada continua fora
+  const admin: CallerContext = { ...caller, isStaff: true };
+  assert(
+    JSON.stringify(voicesWithoutGrant(['voice-por-papel'], grants, admin)) === '[]',
+    'staff deveria alcancar o grant vivo',
+  );
+});
+
+// ────────────────────────────── 2. handler ─────────────────────────────────────
+interface Route {
+  match: string;
+  method?: string;
+  body?: unknown;
+  raw?: Uint8Array;
+  status?: number;
+  contentType?: string;
+}
+
+function withFetch(routes: Route[]) {
+  const original = globalThis.fetch;
+  const seen: Array<{ method: string; url: string }> = [];
+  globalThis.fetch = ((input: RequestInfo | URL, init?: RequestInit) => {
+    const url = typeof input === 'string'
+      ? input
+      : input instanceof URL
+      ? input.toString()
+      : (input as Request).url;
+    const method = (init?.method ?? (typeof input === 'object' && input !== null && 'method' in input ? (input as Request).method : 'GET'))
+      .toUpperCase();
+    seen.push({ method, url });
+    const route = routes.find((r) => url.includes(r.match) && (!r.method || r.method === method));
+    if (!route) return Promise.resolve(new Response('nao stubado', { status: 599 }));
+    if (route.raw) {
+      return Promise.resolve(
+        new Response(route.raw as unknown as BodyInit, {
+          status: route.status ?? 200,
+          headers: { 'content-type': route.contentType ?? 'audio/mpeg' },
+        }),
+      );
+    }
+    return Promise.resolve(
+      new Response(JSON.stringify(route.body ?? null), {
+        status: route.status ?? 200,
+        headers: { 'content-type': 'application/json' },
+      }),
+    );
+  }) as typeof fetch;
+  return {
+    seen,
+    tts: () => seen.filter((s) => s.method === 'POST' && s.url.includes('/functions/v1/elevenlabs-tts')),
+    restore: () => { globalThis.fetch = original; },
+  };
+}
+
+const ENV_KEYS = ['SUPABASE_URL', 'SUPABASE_SERVICE_ROLE_KEY', 'SUPABASE_ANON_KEY'] as const;
+
+function withEnv(values: Partial<Record<(typeof ENV_KEYS)[number], string>>, fn: () => Promise<void>) {
+  const saved = ENV_KEYS.map((k) => [k, Deno.env.get(k)] as const);
+  for (const key of ENV_KEYS) {
+    const value = values[key];
+    if (value === undefined) Deno.env.delete(key);
+    else Deno.env.set(key, value);
+  }
+  return fn().finally(() => {
+    for (const [key, value] of saved) {
+      if (value === undefined) Deno.env.delete(key);
+      else Deno.env.set(key, value);
+    }
+  });
+}
+
+const ENV_OK = {
+  SUPABASE_URL: 'https://stub.supabase.co',
+  SUPABASE_SERVICE_ROLE_KEY: 'service-key-de-teste',
+  SUPABASE_ANON_KEY: 'anon-key-de-teste',
+};
+
+const ROTA_AUTH: Route = { match: '/auth/v1/user', body: { id: USER_B, aud: 'authenticated' } };
+const ROTA_RATE: Route = { match: '/rest/v1/rpc/consume_rate_limit', body: [{ allowed: true, remaining: 19 }] };
+const ROTA_PAPEL_AGENT: Route = { match: '/rest/v1/user_roles', body: [{ role: 'agent' }] };
+const ROTA_PERFIL_B: Route = { match: '/rest/v1/profiles', body: { id: PERFIL_B } };
+const ROTA_NAO_STAFF: Route = { match: '/rest/v1/rpc/is_admin_or_supervisor', body: false };
+const ROTA_GRANT_OK: Route = { match: '/rest/v1/multiplix_voice_grants', body: [grantRow()] };
+const ROTA_ASSET_VAZIO: Route = { match: '/rest/v1/multiplix_voice_assets', method: 'GET', body: null };
+const ROTA_ASSET_INSERT: Route = { match: '/rest/v1/multiplix_voice_assets', method: 'POST', body: { id: ASSET_ID } };
+const ROTA_UPLOAD: Route = { match: '/storage/v1/object/multiplix-voice', method: 'POST', body: { Key: 'ok' } };
+const ROTA_SIGN: Route = {
+  match: '/storage/v1/object/sign/multiplix-voice',
+  method: 'POST',
+  body: { signedURL: '/object/sign/multiplix-voice/comercial/a.mp3?token=abc' },
+};
+const ROTA_TTS: Route = {
+  match: '/functions/v1/elevenlabs-tts',
+  method: 'POST',
+  raw: new Uint8Array([0x49, 0x44, 0x33, 0x04]),
+  contentType: 'audio/mpeg',
+};
+
+function rotaCallerOk(): Route[] {
+  return [ROTA_AUTH, ROTA_RATE, ROTA_PAPEL_AGENT, ROTA_PERFIL_B, ROTA_NAO_STAFF];
+}
+
+function makeRequest(body: unknown, withAuth = true): Request {
+  const headers: Record<string, string> = { 'Content-Type': 'application/json' };
+  if (withAuth) headers.Authorization = 'Bearer token-de-teste';
+  return new Request('https://stub.supabase.co/functions/v1/multiplix-prepare-voice', {
+    method: 'POST', headers, body: JSON.stringify(body),
+  });
+}
+
+function prepareBody(items: VoiceRequestItem[], departamento = 'comercial') {
+  return { action: 'prepare', params: { departamento, items } };
+}
+
+Deno.test('F65 handler: sem bearer devolve 401 e nao toca a rede', async () => {
+  await withEnv(ENV_OK, async () => {
+    const stub = withFetch([]);
+    try {
+      const res = await handleMultiplixPrepareVoiceRequest(makeRequest(prepareBody([item()]), false));
+      assert(res.status === 401, `esperado 401, veio ${res.status}`);
+      assert(stub.seen.length === 0, `nao deveria tocar a rede: ${stub.seen.map((s) => s.url).join(',')}`);
+    } finally {
+      stub.restore();
+    }
+  });
+});
+
+Deno.test('F65 handler: sem env configurada devolve 503', async () => {
+  await withEnv({}, async () => {
+    const res = await handleMultiplixPrepareVoiceRequest(makeRequest(prepareBody([item()])));
+    assert(res.status === 503, `esperado 503, veio ${res.status}`);
+  });
+});
+
+Deno.test('F65 handler: acao fora do contrato devolve 400', async () => {
+  await withEnv(ENV_OK, async () => {
+    const stub = withFetch([ROTA_AUTH, ROTA_RATE]);
+    try {
+      const res = await handleMultiplixPrepareVoiceRequest(makeRequest({ action: 'prepare-now', params: {} }));
+      assert(res.status === 400, `esperado 400, veio ${res.status}`);
+    } finally {
+      stub.restore();
+    }
+  });
+});
+
+Deno.test('F65 handler: 50 contatos com roteiro comum = 1 chamada ao elevenlabs-tts', async () => {
+  await withEnv(ENV_OK, async () => {
+    const stub = withFetch([
+      ...rotaCallerOk(),
+      ROTA_GRANT_OK,
+      ROTA_ASSET_VAZIO,
+      ROTA_ASSET_INSERT,
+      ROTA_UPLOAD,
+      ROTA_TTS,
+      ROTA_SIGN,
+    ]);
+    try {
+      const itens = Array.from({ length: 50 }, () => item());
+      const res = await handleMultiplixPrepareVoiceRequest(makeRequest(prepareBody(itens)));
+      assert(res.status === 200, `esperado 200, veio ${res.status}`);
+      const payload = await res.json() as {
+        distinct: number;
+        chamadas_tts: number;
+        ja_existentes: number;
+        assets: Array<{ indexes: number[]; url: string; expires_in: number }>;
+      };
+      assert(payload.distinct === 1, `deveria haver 1 roteiro distinto: ${payload.distinct}`);
+      assert(payload.chamadas_tts === 1, `50 contatos com roteiro comum deveriam custar 1 chamada: ${payload.chamadas_tts}`);
+      assert(stub.tts().length === 1, `o provedor deveria receber 1 POST: ${stub.tts().length}`);
+      assert(payload.assets.length === 1, `deveria haver 1 ativo: ${payload.assets.length}`);
+      assert(payload.assets[0].indexes.length === 50, 'os 50 contatos deveriam apontar para o mesmo ativo');
+    } finally {
+      stub.restore();
+    }
+  });
+});
+
+Deno.test('F65 handler: roteiros distintos custam uma chamada cada', async () => {
+  await withEnv(ENV_OK, async () => {
+    const stub = withFetch([
+      ...rotaCallerOk(),
+      ROTA_GRANT_OK,
+      ROTA_ASSET_VAZIO,
+      ROTA_ASSET_INSERT,
+      ROTA_UPLOAD,
+      ROTA_TTS,
+      ROTA_SIGN,
+    ]);
+    try {
+      const res = await handleMultiplixPrepareVoiceRequest(
+        makeRequest(prepareBody([item({ texto: 'A' }), item({ texto: 'B' }), item({ texto: 'C' })])),
+      );
+      assert(res.status === 200, `esperado 200, veio ${res.status}`);
+      const payload = await res.json() as { distinct: number; chamadas_tts: number };
+      assert(payload.distinct === 3, `deveriam ser 3 roteiros: ${payload.distinct}`);
+      assert(payload.chamadas_tts === 3, `3 roteiros deveriam custar 3 chamadas: ${payload.chamadas_tts}`);
+      assert(stub.tts().length === 3, `o provedor deveria receber 3 POSTs: ${stub.tts().length}`);
+    } finally {
+      stub.restore();
+    }
+  });
+});
+
+Deno.test('F65 handler: hash JA existente e valido reaproveita o ativo e nao chama o TTS', async () => {
+  await withEnv(ENV_OK, async () => {
+    const stub = withFetch([
+      ...rotaCallerOk(),
+      ROTA_GRANT_OK,
+      { match: '/rest/v1/multiplix_voice_assets', method: 'GET', body: { id: ASSET_ID, caminho: 'comercial/reuso.mp3', invalidated_at: null } },
+      ROTA_SIGN,
+    ]);
+    try {
+      const res = await handleMultiplixPrepareVoiceRequest(makeRequest(prepareBody([item()])));
+      assert(res.status === 200, `esperado 200, veio ${res.status}`);
+      const payload = await res.json() as { chamadas_tts: number; ja_existentes: number; assets: Array<{ caminho: string }> };
+      assert(payload.chamadas_tts === 0, `o ativo valido deveria ser reaproveitado: ${payload.chamadas_tts}`);
+      assert(payload.ja_existentes === 1, `deveria contar 1 reaproveitado: ${payload.ja_existentes}`);
+      assert(stub.tts().length === 0, 'nao deveria chamar o TTS');
+      assert(payload.assets[0].caminho === 'comercial/reuso.mp3', `caminho inesperado: ${payload.assets[0].caminho}`);
+      // O contrato que importa: a consulta NAO pode aceitar ativo INVALIDADO (F45) — o filtro tem que
+      // ir na propria consulta, porque quem responde e o PostgREST.
+      const lookup = stub.seen.find((s) => s.method === 'GET' && s.url.includes('/rest/v1/multiplix_voice_assets'));
+      assert(!!lookup, 'a consulta ao ativo nao aconteceu');
+      const url = new URL(lookup!.url);
+      assert(url.searchParams.get('invalidated_at') === 'is.null', `a consulta deveria filtrar invalidated_at is null: ${lookup!.url}`);
+      assert(url.searchParams.get('hash')?.startsWith('eq.'), `a consulta deveria filtrar pelo hash: ${lookup!.url}`);
+    } finally {
+      stub.restore();
+    }
+  });
+});
+
+Deno.test('F65 handler: voz sem grant vivo devolve 403 e NAO gasta cota do provedor', async () => {
+  await withEnv(ENV_OK, async () => {
+    const stub = withFetch([
+      ...rotaCallerOk(),
+      { match: '/rest/v1/multiplix_voice_grants', body: [grantRow({ voice_id: 'outra-voz' })] },
+    ]);
+    try {
+      const res = await handleMultiplixPrepareVoiceRequest(makeRequest(prepareBody([item()])));
+      assert(res.status === 403, `esperado 403, veio ${res.status}`);
+      const payload = await res.json() as { error: string; voices: string[] };
+      assert(payload.error === MULTIPLIX_VOICE_SEM_AUTORIZACAO, `erro inesperado: ${payload.error}`);
+      assert(JSON.stringify(payload.voices) === JSON.stringify([VOZ_OK]), `voz sem grant inesperada: ${payload.voices}`);
+      assert(stub.tts().length === 0, 'voz sem grant nao poderia gerar audio');
+    } finally {
+      stub.restore();
+    }
+  });
+});
+
+Deno.test('F65 handler: lote acima do teto do provedor devolve erro NOMEADO e nao gera nada', async () => {
+  await withEnv(ENV_OK, async () => {
