+// F65 (Bloco H — Voz) — docs/multiplix/PLANO_FINALIZACAO_MULTIPLIX_100_ETAPAS_2026-09-29.md, linha 139.
+//
+// Enfileira a VOZ IA de um envio: recebe os roteiros FINAIS (ja com as variaveis resolvidas por
+// contato) e devolve, por roteiro DISTINTO, UM ativo de audio no bucket privado
+// `multiplix-voice/<departamento>/`.
+//
+// O que o F65 pede e onde cada parte mora aqui:
+//   * a chave de deduplicacao e `sha256(roteiro final, voice_id, modelo, voice_settings)` — o MESMO
+//     `hash` que `multiplix_voice_assets` (F64) declara UNIQUE. 50 contatos com o mesmo roteiro
+//     produzem 1 hash, logo 1 chamada ao `elevenlabs-tts` e 1 linha, em vez de 50 chamadas;
+//   * o ativo vai para o bucket PRIVADO `multiplix-voice` (F64) e a entrega e sempre por signed URL
+//     de TTL do envio (`DEFAULT_MEDIA_TTL_SECONDS`) — nunca por URL publica;
+//   * o provedor de TTS aceita 20 chamadas por minuto: o lote que passaria disso e recusado com erro
+//     NOMEADO antes de gastar cota, e a fila reenfileira o resto.
+//
+// Quem autoriza a VOZ e o grant do F64: voz sem grant vivo que alcance o chamador nao gera (403) —
+// a MESMA regra da recuperacao (`multiplix-voices`/`assets.sign`). A regra mora em um lugar so:
+// `grantReachesCaller` do `multiplix-voices`, importado aqui (mesmo padrao do `multiplix-dispatch`,
+// que consome funcoes do `multiplix-audience`).
+//
+// O cliente do banco aqui e o SERVICE — a edge ESCREVE o ativo e assina no bucket privado, entao as
+// regras de visibilidade sao aplicadas EXPLICITAMENTE neste arquivo. A autorizacao do CHAMADOR e
+// validada em `requireAuth`. As decisoes ficam em funcoes PURAS, testadas sem rede.
+import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.87.1';
+import { z } from 'https://esm.sh/zod@3.23.8';
+import {
+  enforceRateLimit, errorResponse, getClientIP, handleCors, internalErrorResponse, jsonResponse,
+  requireAuth, requireEnv,
+} from '../_shared/validation.ts';
+import { DEFAULT_MEDIA_TTL_SECONDS } from '../_shared/messaging/media.ts';
+import {
+  VOICE_BUCKET, grantReachesCaller, type CallerContext, type VoiceGrantRow,
+} from '../multiplix-voices/index.ts';
+
+/**
+ * Teto do provedor de TTS (F65: "respeita 20 req/min"): um lote com mais roteiros DISTINTOS que isso
+ * estouraria a cota paga. O lote e recusado nomeado (a fila reenfileira o resto) em vez de gerar
+ * parcialmente — o envio nunca sai com metade dos audios.
+ */
+export const MAX_DISTINCT_TTS_PER_REQUEST = 20;
+
+/** Erro nomeado do lote acima do teto do provedor. */
+export const MULTIPLIX_PREPARE_VOICE_TOO_MANY_DISTINCT = 'multiplix_prepare_voice_too_many_distinct';
+
+/** Erro nomeado quando a voz pedida nao tem grant vivo que alcance o chamador (regra do F64). */
+export const MULTIPLIX_VOICE_SEM_AUTORIZACAO = 'multiplix_voice_sem_autorizacao';
+
+/** Roteiro FINAL de um item: variaveis ja resolvidas, uma entrada por (destinatario x bloco de voz). */
+export interface VoiceRequestItem {
+  texto: string;
+  voice_id: string;
+  modelo: string;
+  voice_settings?: Record<string, unknown> | null;
+}
+
+/** Um roteiro DISTINTO e os indices dos itens que o compartilham (a fila e por roteiro, nao por contato). */
+export interface DistinctScript {
+  hash: string;
+  item: VoiceRequestItem;
+  indexes: number[];
+}
+
+/**
+ * Serializa `voice_settings` de forma CANONICA: a ordem das chaves nao pode mudar o hash, senao o
+ * mesmo audio seria gerado duas vezes so porque o objeto veio montado em outra ordem.
+ */
+export function canonicalVoiceSettings(settings: Record<string, unknown> | null | undefined): string {
+  if (!settings) return '[]';
+  const chaves = Object.keys(settings).sort();
+  return JSON.stringify(chaves.map((chave) => [chave, settings[chave] ?? null]));
+}
+
+/** sha256 em hex de `[roteiro final, voice_id, modelo, voice_settings]` — a chave de dedup do F65. */
+export async function scriptHash(item: VoiceRequestItem): Promise<string> {
+  const payload = [
+    item.texto,
+    item.voice_id,
+    item.modelo,
+    canonicalVoiceSettings(item.voice_settings),
+  ].join('\u0000');
+  const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(payload));
+  return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('');
+}
+
+/**
+ * Caminho do objeto DENTRO do bucket privado (o nome do bucket ja e `multiplix-voice`):
+ * `<departamento>/<hash>.mp3`. O departamento e a pasta que o F65 pede e o hash e o nome do arquivo,
+ * para que o mesmo roteiro reaproveite o mesmo caminho.
+ */
+export function assetPath(departamento: string, hash: string): string {
+  return `${departamento}/${hash}.mp3`;
+}
+
+/** Agrupa os itens pelo hash do roteiro, preservando a ordem da PRIMEIRA aparicao. */
+export async function dedupeScripts(items: VoiceRequestItem[]): Promise<DistinctScript[]> {
+  const porHash = new Map<string, DistinctScript>();
+  for (let index = 0; index < items.length; index += 1) {
+    const item = items[index];
+    const hash = await scriptHash(item);
+    const existente = porHash.get(hash);
+    if (existente) existente.indexes.push(index);
+    else porHash.set(hash, { hash, item, indexes: [index] });
+  }
+  return [...porHash.values()];
+}
+
+/** Vozes pedidas SEM grant vivo que alcance o chamador — a geracao delas e negada (regra do F64). */
+export function voicesWithoutGrant(
+  voiceIds: string[],
+  grants: VoiceGrantRow[],
+  caller: CallerContext,
+): string[] {
+  const permitidas = new Set(
+    grants.filter((grant) => grantReachesCaller(grant, caller)).map((grant) => grant.voice_id),
+  );
+  return [...new Set(voiceIds)].filter((voiceId) => !permitidas.has(voiceId)).sort();
+}
+
+const itemSchema = z.object({
+  texto: z.string().min(1, 'texto e obrigatorio').max(5000),
+  voice_id: z.string().min(1, 'voice_id e obrigatorio').max(100),
+  modelo: z.string().min(1, 'modelo e obrigatorio').max(100),
+  voice_settings: z.record(z.unknown()).nullish(),
+});
+
+const requestSchema = z.object({
+  action: z.literal('prepare'),
+  params: z.object({
+    departamento: z.string().min(1, 'departamento e obrigatorio').max(60),
+    items: z.array(itemSchema).min(1, 'items e obrigatorio').max(5000),
+  }),
+});
+
+type PrepareParams = z.infer<typeof requestSchema>['params'];
+
+interface ErroNomeado {
+  error: string;
+}
+
+interface AssetPreparado {
+  hash: string;
+  asset_id: string;
+  caminho: string;
+  indexes: number[];
+  url: string;
+  expires_in: number;
+}
+
+/** Cria o cliente SERVICE (escreve ativo e assina no bucket privado). */
+function serviceClient(req: Request) {
+  const supabaseUrl = requireEnv('SUPABASE_URL');
+  const serviceKey = requireEnv('SUPABASE_SERVICE_ROLE_KEY');
+  const client = createClient(supabaseUrl, serviceKey, { auth: { persistSession: false } });
+  const authHeader = req.headers.get('Authorization') || req.headers.get('authorization') || '';
+  return { client, supabaseUrl, authHeader };
+}
+
+/**
+ * Gera UM ativo: chama o `elevenlabs-tts` UMA vez, grava o audio no bucket privado e registra a
+ * linha em `multiplix_voice_assets`. So e chamada quando o hash NAO tem ativo valido — e o que faz
+ * "50 contatos com roteiro comum" custarem uma chamada.
+ */
+async function gerarAtivo(
+  client: ReturnType<typeof serviceClient>['client'],
+  supabaseUrl: string,
+  authHeader: string,
+  departamento: string,
+  item: VoiceRequestItem,
+  hash: string,
+  callerProfileId: string | null,
+): Promise<AssetPreparado> {
+  const caminho = assetPath(departamento, hash);
+
+  const ttsRes = await fetch(`${supabaseUrl}/functions/v1/elevenlabs-tts`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', Authorization: authHeader },
+    // `voice_settings` NAO vai no corpo: o `elevenlabs-tts` de hoje fixa as settings. O hash ainda
+    // as cobre, entao duas settings diferentes NUNCA reaproveitam o mesmo audio (lado conservador).
+    body: JSON.stringify({ text: item.texto, voiceId: item.voice_id, modelId: item.modelo }),
+  });
+  if (!ttsRes.ok) {
+    throw new Error(`elevenlabs_tts_${ttsRes.status}`);
+  }
+  const audio = new Uint8Array(await ttsRes.arrayBuffer());
+  if (audio.byteLength === 0) {
+    throw new Error('elevenlabs_tts_vazio');
+  }
+
+  const { error: uploadError } = await client.storage
+    .from(VOICE_BUCKET)
+    .upload(caminho, audio, { contentType: 'audio/mpeg', upsert: true });
+  if (uploadError) {
+    throw new Error(`multiplix_voice_upload_failed: ${uploadError.message}`);
+  }
+
+  const { data: inserido, error: insertError } = await client
+    .from('multiplix_voice_assets')
+    .insert({
+      hash,
+      caminho,
+      voice_id: item.voice_id,
+      modelo: item.modelo,
+      caracteres: item.texto.length,
+      created_by: callerProfileId,
+    })
+    .select('id')
+    .single();
+  if (insertError || !inserido?.id) {
+    throw new Error(`multiplix_voice_asset_insert_failed: ${insertError?.message ?? 'sem id'}`);
+  }
+
+  return {
+    hash,
+    asset_id: inserido.id as string,
+    caminho,
+    indexes: [],
+    url: '',
+    expires_in: DEFAULT_MEDIA_TTL_SECONDS,
+  };
+}
+
+export interface PrepareOutcome {
+  preparados: AssetPreparado[];
+  jaExistentes: number;
+  chamadasTts: number;
+}
+
+/**
+ * Nucleo do F65, com o fetch STUBADO nos testes: percorre os roteiros distintos, reaproveita o ativo
+ * de mesmo hash quando ele existe e valido (INVALIDADO pelo F45 nao serve) e gera os que faltam.
+ * Devolve quantas chamadas de TTS foram feitas — e o que "50 contatos com roteiro comum = 1 chamada"
+ * mede.
+ */
+export async function prepararDistintos(
+  client: ReturnType<typeof serviceClient>['client'],
+  supabaseUrl: string,
+  authHeader: string,
+  departamento: string,
+  distintos: DistinctScript[],
+  callerProfileId: string | null,
+): Promise<PrepareOutcome> {
+  const preparados: AssetPreparado[] = [];
+  let jaExistentes = 0;
+  let chamadasTts = 0;
+
+  for (const distinto of distintos) {
+    const { data: existente, error: lookupError } = await client
+      .from('multiplix_voice_assets')
+      .select('id, caminho, invalidated_at')
+      .eq('hash', distinto.hash)
+      .is('invalidated_at', null)
+      .maybeSingle();
+    if (lookupError) {
+      throw new Error(`multiplix_voice_asset_lookup_failed: ${lookupError.message}`);
+    }
+
+    if (existente?.id && existente.caminho) {
+      jaExistentes += 1;
+      preparados.push({
+        hash: distinto.hash,
+        asset_id: existente.id as string,
+        caminho: existente.caminho as string,
+        indexes: [],
+        url: '',
+        expires_in: DEFAULT_MEDIA_TTL_SECONDS,
+      });
+      continue;
+    }
+
+    const novo = await gerarAtivo(
+      client,
+      supabaseUrl,
+      authHeader,
+      departamento,
+      distinto.item,
+      distinto.hash,
+      callerProfileId,
+    );
+    chamadasTts += 1;
+    preparados.push(novo);
+  }
+
+  // Assina todos os ativos do MESMO jeito (frescos ou reaproveitados): a entrega e sempre por signed
+  // URL de TTL do envio. Junta os indices aqui para a resposta fechar item -> ativo.
+  for (let i = 0; i < preparados.length; i += 1) {
+    const alvo = preparados[i];
+    const { data: assinado, error: signError } = await client.storage
+      .from(VOICE_BUCKET)
+      .createSignedUrl(alvo.caminho, DEFAULT_MEDIA_TTL_SECONDS);
+    if (signError || !assinado?.signedUrl) {
+      throw new Error(`multiplix_voice_sign_failed: ${signError?.message ?? 'sem url'}`);
+    }
+    alvo.url = assinado.signedUrl;
+    alvo.indexes = distintos[i].indexes;
+  }
+
+  return { preparados, jaExistentes, chamadasTts };
+}
+
+export async function handleMultiplixPrepareVoiceRequest(req: Request): Promise<Response> {
+  const cors = handleCors(req);
+  if (cors) return cors;
+
+  try {
+    requireEnv('SUPABASE_URL');
+    requireEnv('SUPABASE_SERVICE_ROLE_KEY');
+  } catch {
+    return errorResponse('Multiplix prepare-voice is not configured', 503, req);
+  }
+
+  const auth = await requireAuth(req);
+  if (auth instanceof Response) return auth;
+  const { userId } = auth;
+
+  // Teto do provedor (F65): 20 por minuto, por chamador.
+  const rate = await enforceRateLimit(
+    `multiplix-prepare-voice:${userId}:${getClientIP(req)}`,
+    MAX_DISTINCT_TTS_PER_REQUEST,
+    60_000,
+  );
+  if (!rate.allowed) {
+    const limited = errorResponse('Rate limit exceeded', 429, req);
+    limited.headers.set('Retry-After', '60');
+    return limited;
+  }
+
+  let body: unknown;
+  try {
+    body = await req.json();
+  } catch {
+    return errorResponse('Invalid JSON body', 400, req);
+  }
+  const parsed = requestSchema.safeParse(body);
+  if (!parsed.success) return errorResponse('Invalid request', 400, req);
+  const { departamento, items } = parsed.data.params as PrepareParams;
+
+  const { client, supabaseUrl, authHeader } = serviceClient(req);
+
+  try {
+    const distintos = await dedupeScripts(items as VoiceRequestItem[]);
+    if (distintos.length > MAX_DISTINCT_TTS_PER_REQUEST) {
+      // Recusa o lote INTEIRO antes de qualquer chamada: gerar parcialmente deixaria o envio com
+      // metade dos audios (o F69 trata a pendencia, mas o lote desnecessariamente grande e erro de quem
+      // enfileirou). O corpo nomeia o motivo para a fila dividir e reenfileirar o resto.
+      return jsonResponse(
+        {
+          error: MULTIPLIX_PREPARE_VOICE_TOO_MANY_DISTINCT,
+          distinct: distintos.length,
+          max: MAX_DISTINCT_TTS_PER_REQUEST,
+        },
+        429,
+        req,
+      );
+    }
+
+    // Quem autoriza a VOZ e o grant do F64 (mesma fonte que `multiplix-voices` usa): papel/perfil do
+    // chamador + grant vivo. Sem grant, a geracao e negada antes de gastar cota do provedor.
+    const [{ data: roleRows }, { data: profileRow }, staffResult] = await Promise.all([
+      client.from('user_roles').select('role').eq('user_id', userId),
+      client.from('profiles').select('id').eq('user_id', userId).maybeSingle(),
+      client.rpc('is_admin_or_supervisor', { _user_id: userId }),
+    ]);
+    const caller: CallerContext = {
+      userId,
+      roleNames: (roleRows ?? []).map((row: { role: string }) => row.role),
+      profileId: (profileRow?.id as string | undefined) ?? null,
+      isStaff: !staffResult.error && staffResult.data === true,
+    };
+
+    const voiceIds = [...new Set(distintos.map((distinto) => distinto.item.voice_id))];
+    const { data: grantRows, error: grantError } = await client
+      .from('multiplix_voice_grants')
+      .select('voice_id, titular, roles, perfis, origem, revoked_at')
+      .in('voice_id', voiceIds);
+    if (grantError) return errorResponse('Falha ao ler os grants de voz', 500, req);
+
+    const semGrant = voicesWithoutGrant(voiceIds, (grantRows ?? []) as VoiceGrantRow[], caller);
+    if (semGrant.length > 0) {
+      return jsonResponse(
+        { error: MULTIPLIX_VOICE_SEM_AUTORIZACAO, voices: semGrant },
+        403,
+        req,
+      );
+    }
+
+    const { preparados, jaExistentes, chamadasTts } = await prepararDistintos(
+      client,
+      supabaseUrl,
+      authHeader,
+      departamento,
+      distintos,
+      caller.profileId,
+    );
+
+    if (preparados.some((ativo) => !ativo.url)) {
+      return errorResponse('Falha ao assinar o ativo de voz', 500, req);
+    }
+
+    return jsonResponse(
+      {
+        departamento,
+        distinct: distintos.length,
+        chamadas_tts: chamadasTts,
+        ja_existentes: jaExistentes,
+        assets: preparados.map((ativo) => ({
+          hash: ativo.hash,
+          asset_id: ativo.asset_id,
+          caminho: ativo.caminho,
+          indexes: ativo.indexes,
+          url: ativo.url,
+          expires_in: ativo.expires_in,
+        })),
+      },
+      200,
+      req,
+    );
+  } catch (error: unknown) {
+    return internalErrorResponse(error, req);
+  }
+}
+
+if (import.meta.main) Deno.serve((req) => handleMultiplixPrepareVoiceRequest(req));
