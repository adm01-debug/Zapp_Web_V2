+ * Converte uma amostra de níveis (0..1) em alturas de barra determinísticas.
+ * Puro: mesma entrada, mesmas alturas — nada de `Math.random()` no render.
+ */
+export function levelBufferToHeights(
+  levels: number[],
+  bars: number,
+  min = 4,
+  max = 28,
