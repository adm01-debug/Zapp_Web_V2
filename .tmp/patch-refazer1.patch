+export async function sendWithBackoff(
+  send: () => Promise<unknown>,
+  options: {
+    attempts?: number;
+    backoffMs?: number[];
+    onRetry?: (attempt: number, waitMs: number) => void;
+  } = {},
+): Promise<boolean> {
+  const attempts = options.attempts ?? SEND_ATTEMPTS;
+  const backoff = options.backoffMs ?? SEND_BACKOFF_MS;
