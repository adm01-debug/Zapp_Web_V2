# Copie para .env.ci.local (fora do git) para o CI local (npm run ci:local)
# usar os mesmos valores que o GitHub passa como secrets.
# Sem eles o passo roda com vazio e o resumo avisa.
#
# O E2E logado (e2e-logado.yml) NÃO precisa de credencial: ele sobe um
# ambiente isolado em Docker (scripts/e2e-isolated/run.sh).

# Usados pelo job "build" do ci.yml
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
