#!/bin/sh
# Ratchet de lint (baseline em scripts/ci/eslint-baseline.json): falha so com divida NOVA.
# Aqui roda so nos arquivos do commit (segundos). O ratchet do repositorio inteiro continua no
# pre-push e no job "Lint & TypeCheck" do CI; rodar tudo a cada commit levava 10-17 min sob carga.
node scripts/ci/lint-ratchet.mjs --staged

# W41: regenera deployment-manifest.json quando supabase/functions/ ou config.toml entram no commit,
# evitando que o CI falhe por manifesto desatualizado.
if git diff --cached --name-only | grep -qE '^supabase/(functions/|config\.toml$)'; then
  node scripts/edge-deploy/generate-manifest.mjs
  git add supabase/deployment-manifest.json
fi
