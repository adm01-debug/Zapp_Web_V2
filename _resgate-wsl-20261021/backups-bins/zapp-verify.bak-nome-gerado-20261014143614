#!/usr/bin/env bash
# Portão local de uma cópia de trabalho do Zapp Web V2 (verify.sh da Arquitetura V2).
# Roda, nesta ordem e parando no primeiro vermelho: trava contra produção, tipos, lint, migrations,
# estrutura do banco local, testes unitários e build. Uso: zapp-verify <cópia> [nome-do-conjunto] [--rapido]
# --rapido pula testes unitários e build (para checagem a cada edição).
# --aceitar <arquivo>: diferenças de estrutura esperadas (formato do zapp-db-local check).
# Também aceita: zapp-verify fast <cópia> [nome]  |  zapp-verify full <cópia> [nome]
set -u
RAPIDO=0
case "${1:-}" in fast) RAPIDO=1; shift;; full) shift;; esac
W="$(cd "${1:-.}" && pwd)" || { echo "cópia não encontrada" >&2; exit 2; }
NOME="${2:-}"; [ "${NOME#--}" != "$NOME" ] && NOME=""
if [ "${*: -1}" = "--aceitar" ]; then echo "ERRO: --aceitar pede um arquivo" >&2; exit 2; fi
ACEITAR=""; ant=""
for a in "$@"; do [ "$a" = "--rapido" ] && RAPIDO=1; [ "$ant" = "--aceitar" ] && ACEITAR="$(realpath -- "$a")"; ant="$a"; done
# registros FORA da cópia, para não sujar o git status dela
LOG="$HOME/.local/state/zapp-verify/$(printf '%s' "$W" | md5sum | cut -c1-12)"; mkdir -p "$LOG"; RES="$LOG/resultado.txt"; : > "$RES"
echo "$W" > "$LOG/copia.txt"
T_INI=$(date +%s)
passo() {  # passo <nome> <comando...>
  local n="$1"; shift; local t0=$(date +%s)
  if ( cd "$W" && "$@" ) > "$LOG/$n.log" 2>&1; then
    printf 'OK      %-12s %4ss\n' "$n" "$(( $(date +%s)-t0 ))" | tee -a "$RES"
  else
    printf 'FALHOU  %-12s %4ss  (ver %s)\n' "$n" "$(( $(date +%s)-t0 ))" "$LOG/$n.log" | tee -a "$RES"
    tail -15 "$LOG/$n.log" | cut -c1-200
    echo "VERIFY: VERMELHO em $n ($(( $(date +%s)-T_INI ))s)" | tee -a "$RES"; exit 1
  fi
}
# >>> verify-par (integrador v3, 07/10/2026)
# Com ZAPP_VERIFY_PAR=1 (só o integrador exporta) tipos, lint e build rodam JUNTOS em segundo plano; os testes rodam
# SOZINHOS depois, com a CPU livre (sob carga os testes estouram o prazo de 15 s e dão vermelho falso). Pouca memória
# livre (< ZAPP_VERIFY_PAR_MEM, 12 GB) = a fila de sempre. Sem a variável nada muda para os agentes.
PAR=0
if [ "${ZAPP_VERIFY_PAR:-0}" = 1 ] && [ "$RAPIDO" = 0 ] \
   && [ "$(awk '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)" -ge "${ZAPP_VERIFY_PAR_MEM:-12000}" ]; then PAR=1; fi
declare -A PARPID
par_matar() {   # derruba a árvore inteira de cada passo que ainda roda (cada um é líder do próprio grupo)
  local f p
  for f in "$LOG"/par-*.pid; do
    [ -f "$f" ] || continue
    p="$(cat "$f" 2>/dev/null)"; [ -n "$p" ] && kill -TERM -- "-$p" 2>/dev/null
    rm -f "$f"
  done
}
par_ini() {   # par_ini <nome> <comando...>: segundo plano; resultado em $LOG/par-<nome>.rc ("<rc> <segundos>")
  local n="$1"; shift; rm -f "$LOG/par-$n.rc" "$LOG/par-$n.pid"
  PN="$n" PL="$LOG" setsid bash -c 'echo $$ > "$PL/par-$PN.pid"; cd "$1" || exit 99; shift; t0=$(date +%s); "$@" > "$PL/$PN.log" 2>&1; rc=$?; echo "$rc $(( $(date +%s)-t0 ))" > "$PL/par-$PN.rc"; exit $rc' _ "$W" "$@" &
  PARPID[$n]=$!
}
par_fim() {   # par_fim <nome>: espera o passo e imprime NO MESMO FORMATO de `passo`; vermelho = derruba os outros e sai
  local n="$1" rc s p
  wait "${PARPID[$n]}" 2>/dev/null
  p="$(cat "$LOG/par-$n.pid" 2>/dev/null)"
  while [ -n "$p" ] && kill -0 "$p" 2>/dev/null; do sleep 1; done
  rm -f "$LOG/par-$n.pid"
  if ! read -r rc s < "$LOG/par-$n.rc" 2>/dev/null; then rc=1; s=0; fi
  if [ "$rc" = 0 ]; then
    printf 'OK      %-12s %4ss\n' "$n" "$s" | tee -a "$RES"
  else
    printf 'FALHOU  %-12s %4ss  (ver %s)\n' "$n" "$s" "$LOG/$n.log" | tee -a "$RES"
    tail -15 "$LOG/$n.log" | cut -c1-200
    par_matar
    echo "VERIFY: VERMELHO em $n ($(( $(date +%s)-T_INI ))s)" | tee -a "$RES"; exit 1
  fi
}
trap par_matar EXIT
# <<< verify-par
# >>> verify-sem-testes (13/10/2026)
# Semáforo da etapa de TESTES: com 20 agentes, 14 vitest ao mesmo tempo esgotaram RAM e swap (medido em 13/10) e o
# supervisor de memória matava os testes, dando vermelho falso e cartões `crashed`. Agora no máximo N `bun run test`
# por vez na máquina inteira (zapp-sem, pool próprio). O integrador usa pool separado (1 vaga) para não esperar atrás
# dos agentes. Ajuste: ZAPP_SEM_TESTES (vagas), ZAPP_SEM_POOL_TESTES (pool). Espera sem teto (não gera vermelho falso).
if [ "${ZAPP_SEM_POOL:-}" = integrador ]; then TPOOL="${ZAPP_SEM_POOL_TESTES:-integrador-testes}"; TVAGAS="${ZAPP_SEM_TESTES:-1}"
else TPOOL="${ZAPP_SEM_POOL_TESTES:-testes}"; TVAGAS="${ZAPP_SEM_TESTES:-3}"; fi
# <<< verify-sem-testes
[ -e "$W/node_modules" ] || passo dependencias bun install --frozen-lockfile
passo db_guard   zapp-db-guard check "$W"
if [ "$PAR" = 1 ]; then
  par_ini tipos zapp-sem "${ZAPP_SEM_POOL:-pesado}" "${ZAPP_SEM_PESADO:-3}" -- /home/joaquim_ataides/arquitetura-v2/typecheck-rapido/tipos.sh
  par_ini lint  zapp-sem "${ZAPP_SEM_POOL:-pesado}" "${ZAPP_SEM_PESADO:-3}" -- node scripts/ci/lint-ratchet.mjs
  par_ini build zapp-db-guard run -- bun run build
  passo migrations node scripts/db-audit/check-migration-drift.mjs
  par_fim tipos; par_fim lint
else
  # 09/10: lint/tsc do repositório inteiro pesam 2–4 GB cada; zapp-sem limita os simultâneos na máquina (pool 'pesado', 3).
  # 19h55: o integrador usa pool próprio (ZAPP_SEM_POOL=integrador, 2) para não esperar vaga atrás dos agentes.
  # No --rapido o lint é só dos arquivos do cartão (zapp-lint-rapido: mesmas regras, baseline recortado) — segundos em vez de minutos.
  passo tipos      zapp-sem "${ZAPP_SEM_POOL:-pesado}" "${ZAPP_SEM_PESADO:-3}" -- /home/joaquim_ataides/arquitetura-v2/typecheck-rapido/tipos.sh
  if [ "$RAPIDO" = 1 ] && [ -z "${ZAPP_LINT_COMPLETO:-}" ]; then passo lint zapp-sem "${ZAPP_SEM_POOL:-pesado}" "${ZAPP_SEM_PESADO:-3}" -- node "$HOME/.local/bin/zapp-lint-rapido.mjs" "$W"
  else passo lint zapp-sem "${ZAPP_SEM_POOL:-pesado}" "${ZAPP_SEM_PESADO:-3}" -- node scripts/ci/lint-ratchet.mjs; fi
  passo migrations node scripts/db-audit/check-migration-drift.mjs
fi
if [ -z "$NOME" ]; then
  # sem nome não existe conjunto: o banco NÃO foi verificado. Antes isto saía VERDE em silêncio.
  printf 'AVISO   %-12s NÃO VERIFICADO: sem nome de conjunto (passe o nome como terceiro argumento)\n' banco_local | tee -a "$RES"
else
  passo travas zapp-db-local travas "$W" "$NOME"
  ST="$HOME/.local/share/zapp-local/stacks/$NOME/estado"
  # Migrations PENDENTES = arquivos da cópia cuja versão ainda não está no registro da PRODUÇÃO.
  # O corte por origin/main estava errado: o que falta subir é o que a produção não tem.
  LEDGER="$(zapp-db-ler "select string_agg(version, ',') as v from supabase_migrations.schema_migrations" 2>/dev/null | python3 -c "
import json,sys
t=sys.stdin.read(); i=t.find('{')
try: print(json.loads(t[i:])['rows'][0]['v'] or '')
except Exception: sys.exit(1)" 2>/dev/null)"; LEDGER_RC=$?
  if [ $LEDGER_RC -ne 0 ]; then LEDGER_OK=0; else LEDGER_OK=1; fi
  NOVAS_MIG="$(LEDGER="$LEDGER" LEDGER_OK="$LEDGER_OK" python3 - "$W" <<'PY'
import glob,os,sys
w=sys.argv[1]
if os.environ.get('LEDGER_OK')!='1': sys.exit(0)
prod=set(os.environ.get('LEDGER','').split(','))
for f in sorted(glob.glob(os.path.join(w,'supabase','migrations','*.sql'))):
    if os.path.basename(f).split('_')[0] not in prod: print(os.path.basename(f))
PY
)"
  if [ "$LEDGER_OK" = 0 ]; then
    printf 'AVISO   %-12s não consegui ler o registro da produção: vale a regra estrita\n' banco_local | tee -a "$RES"
  fi
  if [ -n "$ACEITAR" ]; then passo banco_local zapp-db-local check "$W" "$NOME" --aceitar "$ACEITAR"
  elif [ "$LEDGER_OK" = 1 ] && [ -z "$NOVAS_MIG" ]; then passo banco_local zapp-db-local check "$W" "$NOME"
  else
    t0=$(date +%s); zapp-db-local check "$W" "$NOME" > "$LOG/banco_local.log" 2>&1; rc=$?
    if [ $rc = 0 ]; then printf 'OK      %-12s %4ss\n' banco_local "$(( $(date +%s)-t0 ))" | tee -a "$RES"
    elif [ "$LEDGER_OK" = 1 ] && grep -q '^ESTRUTURA:' "$LOG/banco_local.log" && [ -f "$ST/copia.txt" ] && [ "$(cat "$ST/copia.txt")" = "$W" ]; then
      # só vira AVISO se: (a) toda migration pendente pode ter sido aplicada sem falha no conjunto desta cópia;
      # (b) toda diferença de estrutura é citada no texto de alguma migration pendente, OU (c) já existe
      # no retrato canônico da cópia e nenhuma migration pendente cita o objeto (drift antigo, não do cartão).
      MOTIVO="$(NOVAS="$NOVAS_MIG" W="$W" ST="$ST" python3 - <<'PY'
import os,re,json
w=os.environ['W']; st=os.environ['ST']; novas=[x for x in os.environ['NOVAS'].split('\n') if x]
falhas=open(os.path.join(st,'falhas.tsv'),encoding='utf-8').read() if os.path.exists(os.path.join(st,'falhas.tsv')) else ''
ruins=[n for n in novas if n in falhas]
if ruins: print('migration pendente falhou no conjunto: '+', '.join(ruins)); raise SystemExit(1)
texto=' '.join(open(os.path.join(w,'supabase','migrations',n),encoding='utf-8',errors='ignore').read().lower() for n in novas)
def cita(x):
    x = (x or '').strip().strip('"').lower()   # 12/10: nome com maiúscula/aspas nunca batia com o texto em minúsculas
    return bool(x) and re.search(r'\b' + re.escape(x) + r'\b', texto) is not None
def nome_funcao(obj):
    m = re.match(r'f:([a-z_0-9]+)\(', obj + '(')
    return m.group(1) if m else ''
def explicada(l):
    # cada tipo de diferença tem a sua prova: objeto (coluna, índice, função...) ou papel (permissão)
    partes = l.split('|')
    tipo = partes[0]
    if tipo == 'functions':
        return cita(nome_funcao(partes[1]) if len(partes) > 1 else '')
    if tipo in ('columns', 'indexes', 'constraints', 'defaults', 'policies', 'triggers', 'rls'):
        if len(partes) < 2:
            return False
        obj = partes[1]
        if obj[:2] in ('r:', 't:', 'f:', 'i:'):
            obj = obj[2:]
        nome = obj.split('(')[0].split('.')[-1]
        if cita(nome):
            return True
        base = re.sub(r'_(pkey|fkey|key|check|excl)$', '', nome)   # nome GERADO pelo Postgres: vale citar a tabela/base
        return base != nome and cita(base)
    if tipo in ('relation_grants', 'routine_grants', 'schema_grants'):
        papel = (partes[2] if len(partes) > 2 else '').lower()
        if cita(papel):
            return True
        if tipo == 'relation_grants' and papel in ('authenticated', 'anon', 'service_role') and len(partes) > 1:
            rel = partes[1]
            if rel[:2] in ('r:', 't:'):
                rel = rel[2:]
            rel = rel.split('(')[0].split('.')[-1].strip('"')
            # privilégio PADRÃO do Supabase numa tabela CRIADA pela migration pendente (que não concede nem revoga nada)
            if rel and re.search(r'create\s+table\s+(if\s+not\s+exists\s+)?(public\.)?"?' + re.escape(rel) + r'\b', texto):
                return True
        if tipo == 'routine_grants' and len(partes) > 1:
            return cita(nome_funcao(partes[1]))
        return False
    if tipo == 'default_grants':
        return 'default privileges' in texto
    return False
try:
    RETRATO=json.load(open(os.path.join(w,'supabase','schema-manifest.json'),encoding='utf-8'))
except Exception:
    RETRATO={}   # sem retrato legível não há como provar drift antigo: vale a regra estrita
def nomes_do_objeto(chave):
    # nomes que a linha do diff nomeia (tabela, coluna, função, papel...), sem prefixo de seção,
    # assinatura, papel nem ACL; as aspas dos nomes escolhidos a mão saem fora
    obj=chave
    if obj[:2] in ('r:', 't:', 'f:', 'i:', 'v:'): obj=obj[2:]
    obj=re.sub(r'^[a-z_]+:', '', obj)        # 'relation:' dos constraints, por exemplo
    obj=obj.split('(')[0].split('|')[0]
    return [x.strip('"').lower() for x in obj.split('.')
            if x.strip('"') and x.strip('"').lower() not in ('public', 'auth', 'storage', 'pg_catalog')]
try:
    APLICADAS=' '.join(open(os.path.join(w,'supabase','migrations',n),encoding='utf-8',errors='ignore').read().lower()
                       for n in sorted(os.listdir(os.path.join(w,'supabase','migrations')))
                       if n.endswith('.sql') and n not in novas)
except Exception:
    APLICADAS=''     # sem o texto das já aplicadas só resta a prova pelo retrato
NAO_PALAVRA='A-Za-z0-9_'
def nao_palavra(n):
    # fronteira de palavra sem o escape de barra invertida (ele nao sobrevive à geracao do patch):
    # mesmo efeito da fronteira de palavra para nomes que começam e terminam em letra/digito/_
    return re.search('(?<![' + NAO_PALAVRA + '])' + re.escape(n) + '(?![' + NAO_PALAVRA + '])', APLICADAS) is not None
def drift_canonico(l):
    # Diferença que NÃO vem do cartão. Duas provas: (a) o objeto já existe no retrato canônico da cópia
    # (a produção já o alcançou); (b) o objeto vem de migration JÁ APLICADA na base canônica (a versão
    # está no registro da produção). Em qualquer das duas, nenhuma migration PENDENTE pode citar o
    # objeto nem o seu dono: o que a pendente cita continua provado pelo explicada(); o que só existe
    # na cópia (objeto novo do cartão) continua vermelho.
    if not RETRATO or '|' not in l: return False
    tipo, chave = l.split('|', 1)
    nomes=nomes_do_objeto(chave)
    for n in nomes:
        if cita(n): return False             # migration pendente mexe no objeto: a diferença é do cartão
    if isinstance(RETRATO.get(tipo), dict) and chave in RETRATO[tipo]:
        return True
    if not nomes or not APLICADAS: return False
    for n in nomes:
        if not nao_palavra(n): return False
    return True
pre=[]; sem=[]
try: linhas=[l.strip() for l in open(os.path.join(st,'check-diferencas.txt'),encoding='utf-8') if l.strip()]
except OSError: linhas=[]
for l in linhas:
    if explicada(l): continue
    if drift_canonico(l): pre.append(l); continue
    sem.append(l)
if sem: print('diferença não explicada por migration pendente: '+'; '.join(sem[:3])+(' (+%d)'%(len(sem)-3) if len(sem)>3 else '')); raise SystemExit(1)
print('ok|drift=%d' % len(pre))
for d in pre: print('drift: '+d)
PY
)"; RM=$?
      DRIFT_N="${MOTIVO#*drift=}"; [ "$DRIFT_N" = "$MOTIVO" ] && DRIFT_N=0
      if [ $RM = 0 ] && [ "${MOTIVO%%|*}" = ok ] && [ "$DRIFT_N" = 0 ]; then
        printf 'AVISO   %-12s %4ss  %s — migration(s) pendente(s): %s; toda diferença é citada por elas (ver %s)\n' banco_local "$(( $(date +%s)-t0 ))" \
          "$(grep -m1 '^ESTRUTURA:' "$LOG/banco_local.log")" "$(printf '%s' "$NOVAS_MIG" | tr '\n' ' ')" "$LOG/banco_local.log" | tee -a "$RES"
      elif [ $RM = 0 ] && [ "${MOTIVO%%|*}" = ok ]; then
        printf 'AVISO   %-12s %4ss  %s — migration(s) pendente(s): %s; %s diferença(s) NÃO debitada(s) ao cartão (já no retrato canônico e não citadas por nenhuma pendente: %s) (ver %s)\n' banco_local "$(( $(date +%s)-t0 ))" \
          "$(grep -m1 '^ESTRUTURA:' "$LOG/banco_local.log")" "$(printf '%s' "$NOVAS_MIG" | tr '\n' ' ')" "$DRIFT_N" "$(printf '%s' "$MOTIVO" | sed -n 's/^drift: //p' | head -2 | tr '\n' ';')" "$LOG/banco_local.log" | tee -a "$RES"
      else
        printf 'FALHOU  %-12s %4ss  %s\n' banco_local "$(( $(date +%s)-t0 ))" "${MOTIVO:-diferença de estrutura não explicada}" | tee -a "$RES"
        echo "VERIFY: VERMELHO em banco_local ($(( $(date +%s)-T_INI ))s)" | tee -a "$RES"; exit 1
      fi
    else
      passo banco_local zapp-db-local check "$W" "$NOME"   # nem conseguiu comparar, ou conjunto de outra cópia: vermelho
    fi
  fi
fi
if [ "$RAPIDO" = 0 ]; then
  if [ "$PAR" = 1 ]; then
    par_fim build        # já rodou junto com tipos/lint; os testes entram sozinhos, com a CPU livre
    passo testes   zapp-sem "$TPOOL" "$TVAGAS" -- zapp-db-guard run -- bun run test
  else
    passo testes   zapp-sem "$TPOOL" "$TVAGAS" -- zapp-db-guard run -- bun run test
    passo build    zapp-db-guard run -- bun run build
  fi
fi
if [ -z "$NOME" ]; then echo "VERIFY: VERDE SEM BANCO ($(( $(date +%s)-T_INI ))s) — o banco NÃO foi verificado; registros em $LOG" | tee -a "$RES"
else echo "VERIFY: VERDE ($(( $(date +%s)-T_INI ))s) — registros em $LOG" | tee -a "$RES"; fi
