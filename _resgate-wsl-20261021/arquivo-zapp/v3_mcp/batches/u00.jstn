=== zapp.rpc_insert_followup_sequence(p_rows jsonb) [] SCALAR jsonb
CREATE OR REPLACE FUNCTION zapp.rpc_insert_followup_sequence(p_rows jsonb)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'public', 'pg_catalog'
AS $function$ DECLARE v_count int; BEGIN INSERT INTO zapp.evolution_followup_rules (name, description, trigger_type, trigger_config, template_id, delay_hours, conditions, sequence_order, sequence_group, is_active) SELECT (r->>'name')::text, (r->>'description')::text, (r->>'trigger_type')::text, (r->>'trigger_config')::jsonb, (r->>'template_id')::uuid, (r->>'delay_hours')::integer, (r->>'conditions')::jsonb, (r->>'sequence_order')::integer, (r->>'sequence_group')::uuid, coalesce((r->>'is_active')::boolean, true) FROM jsonb_array_elements(p_rows) r; GET DIAGNOSTICS v_count = ROW_COUNT; RETURN jsonb_build_object('ok',true,'inserted',v_count); EXCEPTION WHEN OTHERS THEN RETURN jsonb_build_object('ok',false,'error',SQLERRM); END; $function$

=== zapp.rpc_pipeline_dashboard() [] SCALAR jsonb
CREATE OR REPLACE FUNCTION zapp.rpc_pipeline_dashboard()
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'evo', 'pg_temp'
AS $function$
DECLARE
  v_wh_health       record;
  v_pending_count   bigint;
  v_failed_count    bigint;
  v_hours_silent    numeric;
  v_health_status   text;
  v_result          jsonb;
BEGIN
  SELECT
  CASE WHEN count(*) FILTER (WHERE created_at >= now() - interval '1 hour') > 0 THEN 'healthy'
       WHEN count(*) FILTER (WHERE created_at >= now() - interval '24 hours') > 0 THEN 'degraded'
       ELSE 'critical' END AS health_status,
  max(created_at) AS last_event_at,
  count(*) FILTER (WHERE NOT processed) AS unresponded,
  count(*) FILTER (WHERE created_at >= now() - interval '1 hour') AS events_1h,
  count(*) FILTER (WHERE created_at >= now() - interval '24 hours') AS events_24h,
  count(*) FILTER (WHERE processed_at >= now() - interval '1 hour') AS processed_1h
INTO v_wh_health
FROM public.evo_webhook_events_v2;

  SELECT count(*) INTO v_pending_count
  FROM public.evo_webhook_events_v2 WHERE status = 'pending';

  SELECT count(*) INTO v_failed_count
  FROM public.evo_webhook_events_v2 WHERE status = 'failed';

  v_hours_silent := CASE
    WHEN v_wh_health.last_event_at IS NOT NULL
    THEN ROUND(EXTRACT(EPOCH FROM (now() - v_wh_health.last_event_at))/3600, 1)
    ELSE 9999
  END;

  v_health_status := CASE
    WHEN v_wh_health.events_1h > 0 THEN 'healthy'
    WHEN v_wh_health.events_24h > 0 THEN 'degraded'
    WHEN v_hours_silent > 24        THEN 'critical'
    ELSE 'unknown'
  END;

  v_result := jsonb_build_object(
    'health_status',       v_health_status,
    'last_event_at',       v_wh_health.last_event_at,
    'events_last_hour',    COALESCE(v_wh_health.events_1h, 0),
    'events_last_24h',     COALESCE(v_wh_health.events_24h, 0),
    'processed_last_hour', COALESCE(v_wh_health.processed_1h, 0),
    'pending_webhooks',    COALESCE(v_pending_count, 0),
    'failed_webhooks',     COALESCE(v_failed_count, 0),
    'hours_silent',        v_hours_silent,
    'source_table',        'evolution_webhook_events_v2',
    'snapshot_at',         now()
  );

  RETURN v_result;
END;
$function$

=== zapp.rpc_refresh_metrics() [] SETOF record
CREATE OR REPLACE FUNCTION zapp.rpc_refresh_metrics()
 RETURNS TABLE(instance_name text, total_messages bigint, msgs_24h bigint, msgs_7d bigint, sent bigint, received bigint, unique_contacts bigint, active_contacts_24h bigint, last_message_at timestamp with time zone, first_message_at timestamp with time zone)
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp'
AS $function$
BEGIN
  REFRESH MATERIALIZED VIEW CONCURRENTLY zapp.mv_instance_metrics;
  RETURN QUERY SELECT
    m.instance_name::text, m.total_messages, m.msgs_24h, m.msgs_7d,
    m.sent, m.received, m.unique_contacts, m.active_contacts_24h, m.last_message_at, m.first_message_at
  FROM zapp.mv_instance_metrics m;
END;
$function$

=== zapp.rpc_toggle_followup_sequence(p_id text, p_is_active boolean) [] SCALAR jsonb
CREATE OR REPLACE FUNCTION zapp.rpc_toggle_followup_sequence(p_id text, p_is_active boolean)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'public', 'pg_catalog'
AS $function$ DECLARE v_count int; v_id uuid := p_id::uuid; BEGIN UPDATE zapp.evolution_followup_rules SET is_active=p_is_active, updated_at=now() WHERE sequence_group=v_id OR (sequence_group IS NULL AND id=v_id); GET DIAGNOSTICS v_count = ROW_COUNT; RETURN jsonb_build_object('ok',true,'updated',v_count); EXCEPTION WHEN OTHERS THEN RETURN jsonb_build_object('ok',false,'error',SQLERRM); END; $function$

=== zapp.rpc_update_message_transcription(p_message_uuid uuid, p_status text, p_transcription text) [] SCALAR void
CREATE OR REPLACE FUNCTION zapp.rpc_update_message_transcription(p_message_uuid uuid, p_status text, p_transcription text DEFAULT NULL::text)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'public', 'auth'
AS $function$
BEGIN
  IF auth.role() <> 'service_role' THEN
    RAISE EXCEPTION 'forbidden: service_role required' USING ERRCODE = '42501';
  END IF;
  UPDATE zapp.evolution_messages
  SET transcription_status = p_status,
      transcription = COALESCE(p_transcription, transcription),
      updated_at = now()
  WHERE id = p_message_uuid;
END;
$function$

=== zapp.rpc_upsert_label(p_id uuid, p_name text, p_label_id text, p_color text, p_label_type text, p_description text, p_sort_order integer, p_instance text) [] SCALAR uuid
CREATE OR REPLACE FUNCTION zapp.rpc_upsert_label(p_id uuid DEFAULT NULL::uuid, p_name text DEFAULT NULL::text, p_label_id text DEFAULT NULL::text, p_color text DEFAULT NULL::text, p_label_type text DEFAULT NULL::text, p_description text DEFAULT NULL::text, p_sort_order integer DEFAULT NULL::integer, p_instance text DEFAULT 'wpp2'::text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'public'
AS $function$
DECLARE v_id uuid;
BEGIN
  IF p_id IS NOT NULL THEN
    -- UPDATE: apenas colunas que existem na tabela
    UPDATE zapp.evolution_labels
    SET name     = COALESCE(p_name, name),
        color    = COALESCE(p_color, color),
        updated_at = NOW()
    WHERE id = p_id
    RETURNING id INTO v_id;
  ELSE
    -- INSERT: apenas colunas que existem na tabela
    INSERT INTO zapp.evolution_labels(name, label_id, color, instance_name)
    VALUES(
      p_name,
      COALESCE(p_label_id, 'custom_' || gen_random_uuid()::text),
      p_color,
      p_instance
    )
    ON CONFLICT (label_id) DO UPDATE
      SET name       = COALESCE(EXCLUDED.name, evolution_labels.name),
          color      = COALESCE(EXCLUDED.color, evolution_labels.color),
          updated_at = NOW()
    RETURNING id INTO v_id;
  END IF;
  RETURN v_id;
END; $function$

=== zapp.rpc_upsert_task(p_title text, p_id uuid, p_description text, p_task_type text, p_assigned_to text, p_contact_id uuid, p_deal_id uuid, p_due_date date, p_priority text, p_tags text[], p_notes text) [] SCALAR zapp.evolution_tasks
CREATE OR REPLACE FUNCTION zapp.rpc_upsert_task(p_title text, p_id uuid DEFAULT NULL::uuid, p_description text DEFAULT NULL::text, p_task_type text DEFAULT 'follow_up'::text, p_assigned_to text DEFAULT NULL::text, p_contact_id uuid DEFAULT NULL::uuid, p_deal_id uuid DEFAULT NULL::uuid, p_due_date date DEFAULT NULL::date, p_priority text DEFAULT 'medium'::text, p_tags text[] DEFAULT NULL::text[], p_notes text DEFAULT NULL::text)
 RETURNS zapp.evolution_tasks
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'monitoring'
AS $function$ DECLARE v_row evolution_tasks; BEGIN IF p_id IS NULL THEN INSERT INTO evolution_tasks(title,description,task_type,assigned_to,contact_id,deal_id,due_date,priority,tags,notes,status,created_at,updated_at) VALUES(p_title,p_description,p_task_type,p_assigned_to,p_contact_id,p_deal_id,p_due_date,p_priority,p_tags,p_notes,'pending',now(),now()) RETURNING * INTO v_row; ELSE UPDATE evolution_tasks SET title=COALESCE(p_title,title), description=COALESCE(p_description,description), assigned_to=COALESCE(p_assigned_to,assigned_to), due_date=COALESCE(p_due_date,due_date), priority=COALESCE(p_priority,priority), notes=COALESCE(p_notes,notes), updated_at=now() WHERE id=p_id RETURNING * INTO v_row; END IF; RETURN v_row; END; $function$



