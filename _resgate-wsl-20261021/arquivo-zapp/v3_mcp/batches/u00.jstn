=== zapp.rpc_create_task(p_title character varying, p_contact_id uuid, p_deal_id uuid, p_due_date date, p_priority character varying, p_assigned_to character varying, p_task_type character varying) [] SCALAR uuid
CREATE OR REPLACE FUNCTION zapp.rpc_create_task(p_title character varying, p_contact_id uuid DEFAULT NULL::uuid, p_deal_id uuid DEFAULT NULL::uuid, p_due_date date DEFAULT (CURRENT_DATE + 1), p_priority character varying DEFAULT 'normal'::character varying, p_assigned_to character varying DEFAULT NULL::character varying, p_task_type character varying DEFAULT 'task'::character varying)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'monitoring'
AS $function$ DECLARE v_task_id UUID; BEGIN INSERT INTO evolution_tasks(title,contact_id,deal_id,due_date,priority,assigned_to,task_type) VALUES(p_title,p_contact_id,p_deal_id,p_due_date,p_priority,p_assigned_to,p_task_type) RETURNING id INTO v_task_id; RETURN v_task_id; END; $function$

=== zapp.rpc_email_health_check() [] SCALAR jsonb
CREATE OR REPLACE FUNCTION zapp.rpc_email_health_check()
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'monitoring'
AS $function$
DECLARE
  v_result jsonb := '{}'::jsonb;
  v_count bigint;
  v_ok boolean := true;
BEGIN
  -- Check tables
  SELECT COUNT(*) INTO v_count FROM pg_tables WHERE schemaname='public' 
    AND tablename IN ('email_tracked_messages','email_tracking_events','email_tracked_links','email_link_click_events','email_contact_scores');
  v_result := v_result || jsonb_build_object('tracking_tables', v_count, 'tables_ok', v_count = 5);
  IF v_count != 5 THEN v_ok := false; END IF;

  -- Check RPCs
  SELECT COUNT(*) INTO v_count FROM pg_proc WHERE proname LIKE 'rpc_email_%';
  v_result := v_result || jsonb_build_object('rpcs', v_count, 'rpcs_ok', v_count >= 10);

  -- Check RLS
  SELECT COUNT(*) INTO v_count FROM pg_tables WHERE schemaname='public' 
    AND tablename IN ('email_tracked_messages','email_tracking_events','email_tracked_links','email_link_click_events','email_contact_scores')
    AND rowsecurity = true;
  v_result := v_result || jsonb_build_object('rls_enabled', v_count, 'rls_ok', v_count = 5);
  IF v_count != 5 THEN v_ok := false; END IF;

  -- Check indexes
  SELECT COUNT(*) INTO v_count FROM pg_indexes WHERE schemaname='public' AND tablename LIKE 'email_track%' AND indexname LIKE 'idx_%';
  v_result := v_result || jsonb_build_object('indexes', v_count, 'indexes_ok', v_count >= 10);

  -- Check edge functions (via HTTP would need separate test)
  v_result := v_result || jsonb_build_object('edge_functions', jsonb_build_array('email-track-pixel', 'email-track-link'));

  -- Data stats
  SELECT COUNT(*) INTO v_count FROM email_tracked_messages;
  v_result := v_result || jsonb_build_object('total_tracked_messages', v_count);
  SELECT COUNT(*) INTO v_count FROM email_tracking_events;
  v_result := v_result || jsonb_build_object('total_events', v_count);
  SELECT COUNT(*) INTO v_count FROM email_contact_scores;
  v_result := v_result || jsonb_build_object('total_contacts_scored', v_count);

  -- Realtime
  SELECT COUNT(*) INTO v_count FROM pg_publication_tables WHERE pubname='supabase_realtime' AND tablename IN ('email_tracking_events','email_tracked_messages');
  v_result := v_result || jsonb_build_object('realtime_tables', v_count);

  -- FTS
  SELECT EXISTS(SELECT 1 FROM pg_indexes WHERE tablename='email_messages' AND indexdef LIKE '%gin%fts%') INTO v_ok;
  v_result := v_result || jsonb_build_object('fts_enabled', v_ok);

  v_result := v_result || jsonb_build_object('status', CASE WHEN v_ok THEN 'healthy' ELSE 'degraded' END, 'checked_at', now());

  RETURN v_result;
END;
$function$

