❌ Erro: REPORT n=40
=== public.set_audio_transcription(p_message_id text, p_transcription text, p_status text, p_error_code text, p_error_reason text) [] SCALAR jsonb
CREATE OR REPLACE FUNCTION public.set_audio_transcription(p_message_id text, p_transcription text, p_status text DEFAULT 'done'::text, p_error_code text DEFAULT NULL::text, p_error_reason text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'evo', 'public'
AS $function$
BEGIN
  UPDATE zapp.evolution_messages_wpp2
  SET
    transcription        = p_transcription,
    transcription_status = p_status,
    error_code           = p_error_code,
    error_reason         = p_error_reason,
    updated_at           = now()
  WHERE message_id = p_message_id;
  RETURN jsonb_build_object('ok', true, 'updated', FOUND, 'status', p_status);
END;
$function$

=== public.update_status_media_url(p_status_id uuid, p_media_url text) [] SCALAR jsonb
CREATE OR REPLACE FUNCTION public.update_status_media_url(p_status_id uuid, p_media_url text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'evo', 'public'
AS $function$
BEGIN
  UPDATE zapp.evolution_whatsapp_status SET local_media_url=p_media_url, media_download_status='done', media_downloaded_at=now() WHERE id=p_status_id;
  RETURN jsonb_build_object('ok', true, 'updated', FOUND);
END; $function$

=== zapp.fn_accept_transfer(p_transfer_id uuid, p_agent_id uuid) [] SCALAR boolean
CREATE OR REPLACE FUNCTION zapp.fn_accept_transfer(p_transfer_id uuid, p_agent_id uuid)
 RETURNS boolean
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp'
AS $function$
DECLARE
    v_conversation_id UUID;
BEGIN
    -- Update the transfer record
    UPDATE zapp.conversation_transfers
    SET 
        status = 'accepted',
        to_agent_id = p_agent_id,
        accepted_at = NOW()
    WHERE 
        id = p_transfer_id AND status = 'pending'
    RETURNING conversation_id INTO v_conversation_id;
    
    IF FOUND THEN
        -- Assign the contact to the new agent
        UPDATE zapp.contacts
        SET assigned_to = p_agent_id
        WHERE id = v_conversation_id;
        
        RETURN TRUE;
    END IF;
    
    RETURN FALSE;
END;
$function$

=== zapp.fn_acknowledge_stale_alerts(p_hours integer) [] SCALAR integer
CREATE OR REPLACE FUNCTION zapp.fn_acknowledge_stale_alerts(p_hours integer DEFAULT 24)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'monitoring'
AS $function$
DECLARE v_count integer;
BEGIN UPDATE evolution_alerts SET acknowledged=true,acknowledged_at=now() WHERE acknowledged=false AND created_at<now()-make_interval(hours:=p_hours) AND severity NOT IN ('critical'); GET DIAGNOSTICS v_count=ROW_COUNT; RETURN v_count; END; $function$

=== zapp.fn_add_to_dlq(p_event_type text, p_instance_name text, p_remote_jid text, p_payload jsonb, p_error_message text, p_error_stack text) [] SCALAR uuid
CREATE OR REPLACE FUNCTION zapp.fn_add_to_dlq(p_event_type text, p_instance_name text, p_remote_jid text, p_payload jsonb, p_error_message text, p_error_stack text DEFAULT NULL::text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'monitoring'
AS $function$ DECLARE v_dlq_id UUID; BEGIN INSERT INTO evolution_webhook_dlq(event_type,instance_name,remote_jid,payload,error_message,error_stack,next_retry_at) VALUES(p_event_type,p_instance_name,p_remote_jid,p_payload,p_error_message,p_error_stack,NOW()+INTERVAL '5 minutes') RETURNING id INTO v_dlq_id; RETURN v_dlq_id; END; $function$

=== zapp.fn_add_to_dlq(p_event_type text, p_instance_name text, p_remote_jid text, p_payload jsonb, p_error_message text, p_error_stack text, p_raw_payload text, p_queue_name text) [] SCALAR uuid
CREATE OR REPLACE FUNCTION zapp.fn_add_to_dlq(p_event_type text, p_instance_name text, p_remote_jid text DEFAULT NULL::text, p_payload jsonb DEFAULT NULL::jsonb, p_error_message text DEFAULT ''::text, p_error_stack text DEFAULT NULL::text, p_raw_payload text DEFAULT NULL::text, p_queue_name text DEFAULT NULL::text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'public'
AS $function$
DECLARE
  v_dlq_id UUID;
  v_resolved_payload JSONB;
BEGIN
  -- Tentar parsear raw_payload como JSONB se payload não foi fornecido
  IF p_payload IS NULL AND p_raw_payload IS NOT NULL THEN
    BEGIN
      v_resolved_payload := p_raw_payload::jsonb;
    EXCEPTION WHEN OTHERS THEN
      v_resolved_payload := NULL; -- BAD JSON: guarda no raw_payload
    END;
  ELSE
    v_resolved_payload := p_payload;
  END IF;

  INSERT INTO zapp.evolution_webhook_dlq (
    event_type, instance_name, remote_jid,
    payload, raw_payload, queue_name,
    error_message, error_stack,
    next_retry_at, status, created_at
  )
  VALUES (
    p_event_type, p_instance_name, p_remote_jid,
    v_resolved_payload, p_raw_payload, p_queue_name,
    p_error_message, p_error_stack,
    now() + INTERVAL '5 minutes', 'pending', now()
  )
  RETURNING id INTO v_dlq_id;

  RETURN v_dlq_id;
END;
$function$

=== zapp.fn_check_fdw_connection() [] SCALAR jsonb
CREATE OR REPLACE FUNCTION zapp.fn_check_fdw_connection()
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'evo', 'public', 'pg_catalog'
AS $function$
DECLARE
  v_start    timestamptz := clock_timestamp();
  v_count    int;
  v_latency  numeric;
BEGIN
  -- Testa acesso a uma view FDW leve (pg_foreign_server não requer FDW vivo,
  -- mas uma query na view zapp.whatsapp_connections — que aponta para evo — valida o canal)
  SELECT count(*) INTO v_count
    FROM pg_foreign_server
   WHERE srvname IS NOT NULL
   LIMIT 1;

  v_latency := round(
    EXTRACT(EPOCH FROM (clock_timestamp() - v_start)) * 1000.0,
    2
  );

  RETURN jsonb_build_object(
    'ok',         true,
    'fdw_count',  v_count,
    'latency_ms', v_latency,
    'checked_at', now()
  );

EXCEPTION WHEN OTHERS THEN
  RETURN jsonb_build_object(
    'ok',         false,
    'error',      SQLERRM,
    'checked_at', now()
  );
END;
$function$

