=== zapp.rpc_list_tags(p_instance text, p_category text, p_search text, p_limit integer) [] SETOF zapp.evolution_tags
CREATE OR REPLACE FUNCTION zapp.rpc_list_tags(p_instance text DEFAULT NULL::text, p_category text DEFAULT NULL::text, p_search text DEFAULT NULL::text, p_limit integer DEFAULT 50)
 RETURNS SETOF zapp.evolution_tags
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'monitoring'
AS $function$
BEGIN
  RETURN QUERY SELECT * FROM zapp.evolution_tags
  WHERE (p_category IS NULL OR category=p_category)
    AND (p_search IS NULL OR name ILIKE '%'||p_search||'%')
