=== public.fn_check_n8n_app_privileges_local() [] SCALAR jsonb
CREATE OR REPLACE FUNCTION public.fn_check_n8n_app_privileges_local()
 RETURNS jsonb
 LANGUAGE sql
 SECURITY DEFINER
 SET search_path TO 'public', 'evo', 'pg_catalog'
AS $function$
SELECT jsonb_object_agg(table_name, jsonb_build_object(
  'sel', has_table_privilege('n8n_app',quote_ident(table_name),'SELECT'),
  'ins', has_table_privilege('n8n_app',quote_ident(table_name),'INSERT'),
  'upd', has_table_privilege('n8n_app',quote_ident(table_name),'UPDATE'),
  'del', has_table_privilege('n8n_app',quote_ident(table_name),'DELETE')
))
FROM (VALUES ('Message'),('MessageUpdate'),('Contact')) t(table_name)
$function$

=== zapp.check_duplicate_request(p_request_id text, p_action text, p_user_id uuid) [] SETOF record
CREATE OR REPLACE FUNCTION zapp.check_duplicate_request(p_request_id text, p_action text, p_user_id uuid)
 RETURNS TABLE(is_duplicate boolean, status_code integer, cached_result jsonb)
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp'
AS $function$
DECLARE
  v_rec zapp.processed_requests%ROWTYPE;
BEGIN
  SELECT * INTO v_rec
  FROM   zapp.processed_requests
  WHERE  request_id = p_request_id
    AND  action     = p_action
    AND  user_id    = p_user_id
    AND  expires_at > now()
  LIMIT 1;
  IF FOUND THEN
    RETURN QUERY SELECT TRUE, v_rec.result_status, v_rec.result_payload;
  ELSE
    RETURN QUERY SELECT FALSE, NULL::INTEGER, NULL::JSONB;
  END IF;
END;
$function$

=== zapp.cleanup_old_failed_messages() [] SCALAR void
CREATE OR REPLACE FUNCTION zapp.cleanup_old_failed_messages()
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'monitoring'
AS $function$
BEGIN
  DELETE FROM zapp.failed_messages
   WHERE status IN ('succeeded', 'abandoned')
     AND COALESCE(succeeded_at, last_attempt_at, created_at) < now() - interval '30 days';
END;
$function$

=== zapp.decrypt_gmail_token(p_encrypted bytea) [] SCALAR text
CREATE OR REPLACE FUNCTION zapp.decrypt_gmail_token(p_encrypted bytea)
 RETURNS text
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'monitoring'
AS $function$
BEGIN
  IF p_encrypted IS NULL THEN RETURN NULL; END IF;
  RETURN pgp_sym_decrypt(p_encrypted, current_setting('app.encryption_key', true));
END;
$function$

