 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'zapp', 'monitoring'
AS $function$
  SELECT id,remote_jid,content,status,created_at FROM evolution_message_queue WHERE instance_name=p_instance AND status='pending' ORDER BY created_at;
$function$



