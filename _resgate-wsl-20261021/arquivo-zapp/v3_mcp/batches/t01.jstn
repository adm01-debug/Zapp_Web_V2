 SET search_path TO 'zapp', 'monitoring'
AS $function$
DECLARE v jsonb;
BEGIN SELECT jsonb_build_object('msgs_last_hour',(SELECT count(*) FROM evolution_messages WHERE created_at>=now()-interval '1 hour'),'events_last_hour',(SELECT count(*) FROM evolution_webhook_events WHERE created_at>=now()-interval '1 hour'),'active_instances',(SELECT count(*) FROM instance_registry WHERE is_active),'open_convs',(SELECT count(*) FROM evolution_conversations WHERE status IN ('aberta','open','active'))) INTO v; RETURN v; END; $function$

=== zapp.fn_get_message_reactions(p_msg_id text, p_inst text) [] SCALAR jsonb
CREATE OR REPLACE FUNCTION zapp.fn_get_message_reactions(p_msg_id text, p_inst text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE sql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'auth', 'extensions'
AS $function$SELECT jsonb_build_object('ok', true, 'message_id', p_msg_id, 'total', (SELECT count(*) FROM evolution_reactions WHERE message_id = p_msg_id AND (p_inst IS NULL OR instance_name = p_inst)), 'reactions', COALESCE((SELECT jsonb_agg(jsonb_build_object('emoji', emoji, 'remote_jid', remote_jid, 'push_name', push_name, 'from_me', from_me, 'reacted_at', reacted_at)) FROM evolution_reactions WHERE message_id = p_msg_id AND (p_inst IS NULL OR instance_name = p_inst)), '[]'::jsonb));$function$

=== zapp.fn_get_or_create_conversation(p_contact_id uuid, p_jid text, p_instance text) [] SCALAR uuid
CREATE OR REPLACE FUNCTION zapp.fn_get_or_create_conversation(p_contact_id uuid, p_jid text, p_instance text DEFAULT 'wpp2'::text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'zapp', 'monitoring'
AS $function$
DECLARE v_id uuid;
BEGIN
  SELECT id INTO v_id FROM evolution_conversations WHERE remote_jid=p_jid AND instance_name=p_instance LIMIT 1;
  IF v_id IS NULL THEN
    INSERT INTO evolution_conversations (remote_jid,contact_id,status,instance_name,first_message_at) VALUES (p_jid,p_contact_id,'aberta',p_instance,now())
    ON CONFLICT (remote_jid,instance_name) DO UPDATE SET contact_id=COALESCE(evolution_conversations.contact_id,EXCLUDED.contact_id), updated_at=now()
    RETURNING id INTO v_id;
  END IF;
  RETURN v_id;
END; $function$

