    "notable_functions": [
      {
        "name": "notify_due_tasks",
        "issue": "race_condition_risk",
        "detail": "Loop over tasks WHERE notified_at IS NULL without FOR UPDATE SKIP LOCKED. Concurrent executions can read the same task and insert duplicate notifications."
      },
      {
        "name": "trigger_pending_multiplix_dispatches",
        "issue": "swallowed_exception",
        "detail": "Two EXCEPTION WHEN OTHERS THEN NULL blocks: one for dispatch state transitions (intended: 'Um dispatch invalido nao pode travar o tick'), one for resume-from-pause. Per-item errors are not logged to any table."
      },
      {
        "name": "trigger_talkx_engine_tick",
        "issue": "swallowed_exception",
        "detail": "Multiple EXCEPTION WHEN OTHERS THEN NULL blocks for per-campaign operations (complete_drained, kick_campaign, talkx-storage-purge). Intentional by design per inline comments. Purge failures escalate to talkx_alerts table (well handled)."
      },
      {
        "name": "trigger_talkx_engine_tick",
        "issue": "fragile_url_derivation",
        "detail": "URL for talkx-storage-purge derived from talkx_scheduler_url via regexp_replace(.../talkx-scheduler -> .../talkx-storage-purge). If the vault URL format changes, storage purge silently stops without error."
      },
      {
        "name": "dispatch_scheduled_messages",
        "issue": "none",
        "detail": "Properly uses FOR UPDATE SKIP LOCKED. Exception handler maps known error codes to stable strings. Good pattern."
      },
      {
        "name": "searchbox_budget_alert_tick",
        "issue": "none",
        "detail": "INSERT ON CONFLICT DO NOTHING for idempotent monthly claim. Calls net.http_post directly. Uses vault for cron secret."
      }
    ]
